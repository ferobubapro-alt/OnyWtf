                    Telemetry.CoinsCollected = currentCoins
                else
                    Telemetry.CoinsCollected = math.min(Telemetry.BagCapacity, Telemetry.CoinsCollected + 1)
                end
                if type(maxCoins) == "number" and maxCoins > 0 then
                    Telemetry.BagCapacity = maxCoins
                end
            end))
        end
