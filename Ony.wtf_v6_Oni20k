        local char = plr.Character
        local bp = plr:FindFirstChild("Backpack")
        if char then
            local k = char:FindFirstChild("Knife")
            if k and k:IsA("Tool") then
                return true, k
            end
            for _, tool in ipairs(char:GetChildren()) do
                if tool:IsA("Tool") and (tool:FindFirstChild("Stab") or tool:FindFirstChild("Slash") or tool:FindFirstChild("Throw")) then
                    return true, tool
                end
            end
        end
        if bp then
            local k = bp:FindFirstChild("Knife")
            if k and k:IsA("Tool") then
                return true, k
            end
            for _, tool in ipairs(bp:GetChildren()) do
                if tool:IsA("Tool") and (tool:FindFirstChild("Stab") or tool:FindFirstChild("Slash") or tool:FindFirstChild("Throw")) then
                    return true, tool
                end
            end
        end
        return false, nil
