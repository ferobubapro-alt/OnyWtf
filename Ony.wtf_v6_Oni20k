local function SetP2PSinkPlayer(targetPlayer: Player, enable: boolean)
    BroadcastAnimateBridgePacket(enable and "SINK" or "UNSINK", targetPlayer.Name, "")
    RecordPlayerP2PEffect(targetPlayer.Name, "SUNK", enable)
    if targetPlayer.Character then
        local tHrp = targetPlayer.Character:FindFirstChild("HumanoidRootPart") :: BasePart?
        if tHrp then
            tHrp.CFrame = tHrp.CFrame + Vector3.new(0, enable and -6.5 or 6.5, 0)
            tHrp.Anchored = enable
        end
    end
end

