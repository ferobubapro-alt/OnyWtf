function MathEngine.Clamp(val, low, high)
    if val < low then
        return low
    end
    if val > high then
        return high
    end
    return val
end

function MathEngine.Lerp(a, b, t)
    return a + (b - a) * MathEngine.Clamp(t, 0, 1)
end

function MathEngine.LerpVector3(v1, v2, t)
    local alpha = MathEngine.Clamp(t, 0, 1)
    return v1:Lerp(v2, alpha)
end

function MathEngine.LerpColor3(c1, c2, t)
    local alpha = MathEngine.Clamp(t, 0, 1)
    return c1:Lerp(c2, alpha)
end

function MathEngine.WorldToScreen(worldPos)
    if not Camera then
        return Vector2.zero, false, 0
    end
    local viewportPoint, onScreen = Camera:WorldToViewportPoint(worldPos)
    return Vector2.new(viewportPoint.X, viewportPoint.Y), onScreen, viewportPoint.Z
end

function MathEngine.GetDistanceFromLocal(worldPos)
    local char = LocalPlayer and LocalPlayer.Character
    local hrp = char and char:FindFirstChild("HumanoidRootPart")
    if not hrp then
        if Camera then
            return (Camera.CFrame.Position - worldPos).Magnitude
        end
        return 0
    end
    return (hrp.Position - worldPos).Magnitude
end

function MathEngine.GetPingSeconds()
    local ok, ping = pcall(function()
        if LocalPlayer and type(LocalPlayer.GetNetworkPing) == "function" then
            return LocalPlayer:GetNetworkPing()
        end
        return 0.065
    end)
    if ok and type(ping) == "number" and ping > 0 then
        return MathEngine.Clamp(ping, 0.015, 0.45)
    end
    return 0.065
end

function MathEngine.Get3DBoundingBoxCorners(cf, sizeVec)
    local hx = sizeVec.X * 0.5
    local hy = sizeVec.Y * 0.5
    local hz = sizeVec.Z * 0.5
    return {
        cf * Vector3.new(-hx,  hy, -hz),
        cf * Vector3.new( hx,  hy, -hz),
        cf * Vector3.new( hx,  hy,  hz),
        cf * Vector3.new(-hx,  hy,  hz),
        cf * Vector3.new(-hx, -hy, -hz),
        cf * Vector3.new( hx, -hy, -hz),
        cf * Vector3.new( hx, -hy,  hz),
        cf * Vector3.new(-hx, -hy,  hz),
    }
end

