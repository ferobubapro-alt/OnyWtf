    function SpatialNavAtlas:GetNearestSafeCandyNode(zoneName, currentPos)
        local zone = self[zoneName] or self["MM2_Workplace"]
        if not zone or not zone.Sectors then return currentPos end
        local bestNode = nil
        local bestDist = math.huge
        for _, sec in ipairs(zone.Sectors) do
            local d = (sec.Center - currentPos).Magnitude
            if d < bestDist then
                bestDist = d
                bestNode = sec
            end
        end
        return bestNode
