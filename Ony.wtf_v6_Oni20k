local ExecuteCommandString: (rawInput: string) -> ()

RefreshCommandListUI = function(filterText: string?)
    CmdTextBox.PlaceholderText = string.format("Command Bar (%s)", State.Prefix)
    for _, child in ipairs(CmdsScroll:GetChildren()) do
        if child:IsA("TextButton") then
            child:Destroy()
        end
    end

    local q = string.lower(string.gsub(filterText or "", "^" .. State.Prefix, ""))
    q = string.gsub(q, "^%s*(.-)%s*$", "%1")
    local firstWord = string.split(q, " ")[1] or ""

    for idx, cmd in ipairs(CommandList) do
        local match = (firstWord == "")
            or string.find(string.lower(cmd.Name), firstWord, 1, true) ~= nil
            or string.find(string.lower(cmd.Description), firstWord, 1, true) ~= nil

        if not match then
            for _, al in ipairs(cmd.Aliases) do
                if string.find(string.lower(al), firstWord, 1, true) then
                    match = true
                    break
                end
            end
        end

        if match then
            local unlocked = (State.LocalRankLevel >= cmd.MinTier)
            local rowBtn = Instance.new("TextButton")
            rowBtn.Name = "CmdRow_" .. cmd.Name
            rowBtn.LayoutOrder = idx
            rowBtn.Size = UDim2.new(1, -6, 0, 21)
            rowBtn.BackgroundColor3 = Color3.fromRGB(42, 42, 44)
            rowBtn.BackgroundTransparency = 0.35
            rowBtn.BorderSizePixel = 0
            rowBtn.Font = Enum.Font.Gotham
            rowBtn.TextSize = 12
            rowBtn.TextXAlignment = Enum.TextXAlignment.Left
            rowBtn.TextColor3 = unlocked and Color3.fromRGB(240, 240, 245) or Color3.fromRGB(145, 145, 150)

            local aliasText = #cmd.Aliases > 0 and (" / " .. table.concat(cmd.Aliases, " / ")) or ""
            local argsText = (cmd.Args and #cmd.Args > 0) and (" " .. cmd.Args) or ""
            local lockSuffix = unlocked and "" or string.format(" [Kilit T%d]", cmd.MinTier)
            rowBtn.Text = "  " .. cmd.Name .. aliasText .. argsText .. lockSuffix
            rowBtn.Parent = CmdsScroll

            rowBtn.MouseButton1Click:Connect(function()
                PlayUiSound("click")
                local typed = CmdTextBox.Text
                local typedArgs = string.split(typed, " ")
                if #typedArgs >= 2 then
                    ExecuteCommandString(cmd.Name .. " " .. table.concat(typedArgs, " ", 2))
                else
                    ExecuteCommandString(cmd.Name .. " " .. State.SelectedTargetMode)
                end
            end)
        end
    end
end

