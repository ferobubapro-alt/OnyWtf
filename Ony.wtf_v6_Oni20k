                if (r == "Sheriff" or r == "Hero") and Ony.IsPlayerInActiveRound(plr) then
                    return plr
                end
            end
        end
        return nil
    end
    Ony.FindSheriffPlayer = Ony.GetSheriffPlayer

    function Ony.GetClosestAlivePlayerToPoint(worldPos, roleFilter)
        local bestPlr = nil
        local bestDist = math.huge
        for _, plr in ipairs(Players:GetPlayers()) do
            if plr ~= LocalPlayer and Ony.IsPlayerInActiveRound(plr) then
                local r = Ony.ResolvePlayerRole(plr)
                local roleOk = (not roleFilter)
                    or (roleFilter == "Murderer" and r == "Murderer")
                    or (roleFilter == "Sheriff" and (r == "Sheriff" or r == "Hero"))
                    or (roleFilter == "Innocent" and r == "Innocent")
                if roleOk then
                    local hrp = plr.Character and plr.Character:FindFirstChild("HumanoidRootPart")
                    if hrp then
                        local d = (hrp.Position - worldPos).Magnitude
                        if d < bestDist then
                            bestDist = d
                            bestPlr = plr
                        end
                    end
                end
            end
        end
        return bestPlr, bestDist
    end

    Ony.CachedMapWalls = {}
    Ony.XRayActiveState = false

    function Ony.FindActiveMap()
        if Ony.CachedActiveMap and Ony.CachedActiveMap.Parent == Workspace and (Ony.CachedActiveMap:FindFirstChild("CoinContainer") or Ony.CachedActiveMap:FindFirstChild("Spawns")) then
            return Ony.CachedActiveMap
        end
        for _, child in ipairs(Workspace:GetChildren()) do
            if child:IsA("Model") or child:IsA("Folder") then
                if child:FindFirstChild("CoinContainer") or child:FindFirstChild("Spawns") or KnownMM2MapNames[child.Name] then
                    Ony.CachedActiveMap = child
                    Telemetry.ActiveMapName = child.Name
                    Ony.CachedMapWalls = {}
                    for _, desc in ipairs(child:GetDescendants()) do
                        if desc:IsA("BasePart") and desc.Transparency < 0.85 and not desc:IsDescendantOf(child:FindFirstChild("CoinContainer") or Ony.ScreenGui) then
                            table.insert(Ony.CachedMapWalls, desc)
                        end
                    end
                    return child
                end
            end
        end
        Telemetry.ActiveMapName = "Lobby"
        return nil
    end

    function Ony.UpdateXRayMapWalls()
        local shouldXRay = (Flags["xray_walls"] == true)
        local opacityPct = tonumber(Values["xray_opacity"]) or 60
        local modifier = MathEngine.Clamp(opacityPct / 100, 0.1, 0.92)

        if shouldXRay then
            local map = Ony.FindActiveMap()
            if map then
                Ony.XRayActiveState = true
                for _, part in ipairs(Ony.CachedMapWalls) do
                    if part and part.Parent then
                        part.LocalTransparencyModifier = modifier
                    end
                end
            end
        elseif Ony.XRayActiveState then
            Ony.XRayActiveState = false
            for _, part in ipairs(Ony.CachedMapWalls) do
                if part and part.Parent then
                    part.LocalTransparencyModifier = 0
                end
            end
        end
    end

    function Ony.FindBestCoinTarget()
        local map = Ony.FindActiveMap()
        if not map then
            return nil, 0
        end
        local container = map:FindFirstChild("CoinContainer")
        if not container then
            return nil, 0
        end

        local char = LocalPlayer.Character
        local hrp = char and char:FindFirstChild("HumanoidRootPart")
        if not hrp then
            return nil, 0
        end

        local murderer = Ony.GetMurdererPlayer()
        local mHrp = murderer and murderer.Character and murderer.Character:FindFirstChild("HumanoidRootPart")

        local validCoins = {}
        for _, coin in ipairs(container:GetChildren()) do
            local part = coin:IsA("BasePart") and coin or coin:FindFirstChildWhichIsA("BasePart")
            if part and part.Parent and part.Transparency < 0.95 then
                local hasTouch = part:FindFirstChildOfClass("TouchTransmitter") or part:FindFirstChild("TouchInterest") or coin:FindFirstChild("TouchInterest", true)
                if hasTouch ~= nil or coin.Name == "Coin_Server" or coin.Name == "Coin" or coin.Name == "SnowToken" or coin.Name == "Egg" or coin.Name == "Candy" or coin.Name == "BeachBall" then
                    table.insert(validCoins, part)
                end
            end
        end

        if #validCoins == 0 then
            return nil, 0
        end

        local prioritizeClusters = (Flags["prioritize_coin_clusters"] == true)
        local bestPart = nil
        local bestScore = math.huge

        for _, part in ipairs(validCoins) do
            local dist = (hrp.Position - part.Position).Magnitude
            local score = dist

            if mHrp then
                local distToMurderer = (mHrp.Position - part.Position).Magnitude
                if distToMurderer < 18 then
                    score = score + 220
                elseif distToMurderer < 30 then
                    score = score + 75
                end
            end

            if prioritizeClusters then
                local neighbors = 0
                for _, other in ipairs(validCoins) do
                    if other ~= part and (other.Position - part.Position).Magnitude <= 26 then
                        neighbors = neighbors + 1
                    end
                end
                score = score - (neighbors * 9.5)
            end

            if score < bestScore then
                bestScore = score
                bestPart = part
            end
        end

        if bestPart then
            return bestPart, (hrp.Position - bestPart.Position).Magnitude
        end
        return nil, 0
    end
end)

