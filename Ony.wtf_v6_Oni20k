-- [12] KOMUT ÇALIŞTIRICI MOTOR & ARAMA KANCALARI
ExecuteCommandString = function(rawInput: string)
    local activePfx = ResolvePersonalPrefix(LocalPlayer.Name)
    local clean = rawInput
    if string.sub(clean, 1, #activePfx) == activePfx then
        clean = string.sub(clean, #activePfx + 1)
    elseif string.sub(clean, 1, 1) == ";" then
        clean = string.sub(clean, 2)
    end
    clean = string.gsub(clean, "^%s*(.-)%s*$", "%1")
    if clean == "" then return end

    local parts = string.split(clean, " ")
    local cmdName = string.lower(parts[1] or "")
    table.remove(parts, 1)
    local args = parts

    local resolvedCmd = CommandRegistry[cmdName]
    if not resolvedCmd then
        for _, c in ipairs(CommandList) do
            for _, alias in ipairs(c.Aliases) do
                if string.lower(alias) == cmdName then
                    resolvedCmd = c
                    break
                end
            end
            if resolvedCmd then break end
        end
    end

    if not resolvedCmd then
        PlayUiSound("error")
        SendNotification("BİLİNMEYEN KOMUT", string.format("'%s' komutu bulunamadı.", cmdName), Color3.fromRGB(239, 68, 68))
        return
    end

    local allowed, reason = CanPlayerExecuteCommand(State.LocalRankLevel, resolvedCmd.Name)
    if not allowed then
        PlayUiSound("error")
        SendNotification("YETKİ KİLİTLİ", reason, Color3.fromRGB(239, 68, 68))
        return
    end

    PlayUiSound("command")
    local targets = ResolveTargetPlayers(args[1])
    if #targets == 0 then
        targets = { LocalPlayer }
    end

    local myChar = LocalPlayer.Character
    local myHrp = myChar and myChar:FindFirstChild("HumanoidRootPart") :: BasePart?
    local myHum = myChar and myChar:FindFirstChildOfClass("Humanoid")
    local cam = Workspace.CurrentCamera

    for _, targetPlr in ipairs(targets) do
        pcall(function()
            resolvedCmd.Action(targetPlr, args, myHrp, myHum, cam)
        end)
    end

    SendNotification(
        string.upper(resolvedCmd.Name) .. " ÇALIŞTIRILDI",
        string.format("Hedef: %s (%d oyuncu)", args[1] or State.SelectedTargetMode, #targets),
        GetTierData(State.LocalRankLevel).Color,
        2.5
    )

    if not State.KeepMenuOpen then
        ToggleAnimatedMainMenu(false)
    end
end

