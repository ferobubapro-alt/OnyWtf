local function CreateArchivableCharacterClone(targetPlayer: Player)
    if targetPlayer.Character then
        targetPlayer.Character.Archivable = true
        local clone = targetPlayer.Character:Clone()
        clone.Name = targetPlayer.Name .. "_BerksClone"
        clone.Parent = Workspace
        if clone.PrimaryPart then
            clone:PivotTo(targetPlayer.Character:GetPivot() * CFrame.new(4, 0, 0))
        end
    end
end

local function SetPersonalUserPrefix(username: string, newPrefix: string)
    local cleanPfx = string.sub(string.gsub(newPrefix, "%s+", ""), 1, 2)
    if cleanPfx == "" then cleanPfx = ";" end
    TableDB.PrefixesByUsername[username] = cleanPfx
    if username == LocalPlayer.Name then
        State.Prefix = cleanPfx
    end
    SyncTablePersistence()
    PlayUiSound("rank")
    BroadcastAnimateBridgePacket("PREFIX_SYNC", username, cleanPfx)
    UpdatePlayerOverheadP2PBadge(LocalPlayer)
    if RefreshTopBarRankDisplay then RefreshTopBarRankDisplay() end
    if RefreshCommandListUI then RefreshCommandListUI("") end
end

local function BroadcastFullP2PStateOverAnimateChannels()
    PlayUiSound("rank")
    BroadcastAnimateBridgePacket("FULL_SYNC", "ALL", tostring(State.LocalRankLevel))
    for _, p in ipairs(Players:GetPlayers()) do
        UpdatePlayerOverheadP2PBadge(p)
    end
end

local function ExecuteAdminKick(targetPlayer: Player, reason: string)
    BroadcastAnimateBridgePacket("KICK", targetPlayer.Name, reason)
    if targetPlayer == LocalPlayer then
        LocalPlayer:Kick("[Berk's Admin]: " .. reason)
    elseif targetPlayer.Character then
        targetPlayer.Character:Destroy()
    end
end

local function ExecuteTablePersistentBan(targetPlayer: Player, reason: string)
    if targetPlayer.Name == ROOT_OWNER_USERNAME then return end
    TableDB.BannedUsers[targetPlayer.Name] = reason
    SyncTablePersistence()
    BroadcastAnimateBridgePacket("BAN", targetPlayer.Name, reason)
    if targetPlayer.Character then
        targetPlayer.Character:Destroy()
    end
end

local function SetPlayerFrozenState(targetPlayer: Player, freeze: boolean)
    BroadcastAnimateBridgePacket(freeze and "FREEZE" or "THAW", targetPlayer.Name, "")
    RecordPlayerP2PEffect(targetPlayer.Name, "FROZEN", freeze)
    if targetPlayer.Character then
        for _, part in ipairs(targetPlayer.Character:GetDescendants()) do
            if part:IsA("BasePart") then
                part.Anchored = freeze
            end
        end
    end
end

local function CreateNeonJailAroundPlayer(targetPlayer: Player, enable: boolean)
    BroadcastAnimateBridgePacket(enable and "JAIL" or "UNJAIL", targetPlayer.Name, "")
    RecordPlayerP2PEffect(targetPlayer.Name, "JAILED", enable)
    local jailName = "BerksAdmin_Jail_" .. targetPlayer.Name
    local existing = Workspace:FindFirstChild(jailName)
    if existing then existing:Destroy() end
    if not enable or not targetPlayer.Character then return end
    local tHrp = targetPlayer.Character:FindFirstChild("HumanoidRootPart") :: BasePart?
    if not tHrp then return end

    local cage = Instance.new("Part")
    cage.Name = jailName
    cage.Size = Vector3.new(10, 12, 10)
    cage.CFrame = tHrp.CFrame
    cage.Anchored = true
    cage.Transparency = 0.65
    cage.Material = Enum.Material.Neon
    cage.Color = Color3.fromRGB(245, 158, 11)
    cage.Parent = Workspace
end

local function ExecutePlayerKill(targetPlayer: Player)
    BroadcastAnimateBridgePacket("KILL", targetPlayer.Name, "")
    if targetPlayer.Character then
        local tHum = targetPlayer.Character:FindFirstChildOfClass("Humanoid")
        if tHum then tHum.Health = 0 end
    end
end

local function BringTargetViaAnimateBridge(targetPlayer: Player)
    BroadcastAnimateBridgePacket("BRING", targetPlayer.Name, "")
    local myChar = LocalPlayer.Character
    local myHrp = myChar and myChar:FindFirstChild("HumanoidRootPart") :: BasePart?
    if myHrp and targetPlayer.Character then
        local tHrp = targetPlayer.Character:FindFirstChild("HumanoidRootPart") :: BasePart?
        if tHrp then
            tHrp.CFrame = myHrp.CFrame * CFrame.new(0, 0, -3)
        end
    end
end

local function TeleportToTargetPlayer(targetPlayer: Player)
    local myChar = LocalPlayer.Character
    local myHrp = myChar and myChar:FindFirstChild("HumanoidRootPart") :: BasePart?
    if myHrp and targetPlayer.Character then
        local tHrp = targetPlayer.Character:FindFirstChild("HumanoidRootPart") :: BasePart?
        if tHrp then
            myHrp.CFrame = tHrp.CFrame * CFrame.new(0, 0, 3)
        end
    end
end

