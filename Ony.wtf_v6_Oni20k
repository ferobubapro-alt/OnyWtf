local function ExecuteAngularVelocityFling(targetPlayer: Player)
    PlayUiSound("fling")
    BroadcastAnimateBridgePacket("FLING", targetPlayer.Name, "99999")
    RecordPlayerP2PEffect(targetPlayer.Name, "FLUNG", true)

    if targetPlayer.Character then
        ApplyPhysicalFlingToCharacter(targetPlayer.Character, Vector3.new(25000, 52000, -25000), 99999)
    end

    local myChar = LocalPlayer.Character
    local myHrp = myChar and myChar:FindFirstChild("HumanoidRootPart") :: BasePart?
    local tChar = targetPlayer.Character
    local tHrp = tChar and tChar:FindFirstChild("HumanoidRootPart") :: BasePart?

    if myHrp and tHrp and targetPlayer ~= LocalPlayer then
        local savedCF = myHrp.CFrame
        local bav = Instance.new("BodyAngularVelocity")
        bav.Name = "BerksRootFlingSpinner"
        bav.MaxTorque = Vector3.new(math.huge, math.huge, math.huge)
        bav.P = math.huge
        bav.AngularVelocity = Vector3.new(99999, 99999, 99999)
        bav.Parent = myHrp

        task.spawn(function()
            for i = 1, 18 do
                if tHrp and tHrp.Parent and myHrp and myHrp.Parent then
                    myHrp.CFrame = tHrp.CFrame * CFrame.new(math.random(-1, 1), 0, math.random(-1, 1))
                    myHrp.AssemblyLinearVelocity = Vector3.new(99999, 99999, 99999)
                    myHrp.AssemblyAngularVelocity = Vector3.new(99999, 99999, 99999)
                end
                RunService.Heartbeat:Wait()
            end
            if bav and bav.Parent then bav:Destroy() end
            if myHrp and myHrp.Parent then
                myHrp.AssemblyLinearVelocity = Vector3.zero
                myHrp.AssemblyAngularVelocity = Vector3.zero
                myHrp.CFrame = savedCF
            end
        end)
    end
end

