    function MM2MapDatabase:GetProfile(mapName)
        local key = tostring(mapName or Telemetry.ActiveMapName or "Workplace")
        if self.Maps[key] then
            return self.Maps[key]
        end
        for k, prof in pairs(self.Maps) do
            if string.find(string.lower(key), string.lower(k), 1, true) then
                return prof
            end
        end
        return self.Maps["Workplace"]
    end

    function MM2MapDatabase:GetOptimalHidingPosition(mapInstance, murdererWorldPos)
        local prof = self:GetProfile(mapInstance and mapInstance.Name or Telemetry.ActiveMapName)
        local origin = Vector3.zero
        if mapInstance then
            local sp = mapInstance:FindFirstChild("Spawns") and mapInstance.Spawns:FindFirstChildWhichIsA("BasePart")
            if sp then
                origin = sp.Position
            end
        end
        local bestWorld = origin + Vector3.new(0, prof.SafeHeight or 135, 0)
        local bestScore = -math.huge

        for _, spot in ipairs(prof.HidingSpots or {}) do
            local candidate = origin + spot.Offset
            local score = (spot.SafetyRating or 8) * 15
            if murdererWorldPos then
                local distFromM = (candidate - murdererWorldPos).Magnitude
                score = score + distFromM * 1.4
            end
            if score > bestScore then
                bestScore = score
                bestWorld = candidate
            end
        end
        return bestWorld
    end

    -- // 10.2 Multi-Whisker Spatial Obstacle Avoidance & Anti-Stuck Pathfinder
    local OnyPathfinder = {
        LastPosition = Vector3.zero,
        StuckFrames = 0,
        WhiskerAngles = { -75, -45, -20, 0, 20, 45, 75 },
    }
    Ony.OnyPathfinder = OnyPathfinder

    function OnyPathfinder:ComputeSteeringVector(originPos, targetPos, ignoreList)
        local toTarget = targetPos - originPos
        local flatDir = Vector3.new(toTarget.X, 0, toTarget.Z)
        if flatDir.Magnitude < 0.5 then
            return Vector3.zero
        end
        local unitGoal = flatDir.Unit

        local params = RaycastParams.new()
        params.FilterType = Enum.RaycastFilterType.Exclude
        params.IgnoreWater = true
        local filter = {}
        if LocalPlayer.Character then
            table.insert(filter, LocalPlayer.Character)
        end
        if type(ignoreList) == "table" then
            for _, inst in ipairs(ignoreList) do
                table.insert(filter, inst)
            end
        end
        params.FilterDescendantsInstances = filter

        -- Check direct path first
        local directHit = Workspace:Raycast(originPos, unitGoal * 7.5, params)
        if not directHit then
            return unitGoal
        end

        -- Evaluate whisker fan to steer smoothly around walls/doors
        local bestDir = unitGoal
        local bestClearance = -1
        local baseAngle = math.atan2(unitGoal.Z, unitGoal.X)

        for _, deg in ipairs(self.WhiskerAngles) do
            local rad = baseAngle + math.rad(deg)
            local testDir = Vector3.new(math.cos(rad), 0, math.sin(rad))
            local hit = Workspace:Raycast(originPos, testDir * 11, params)
            local clearance = hit and (hit.Position - originPos).Magnitude or 11
            local alignmentPenalty = math.abs(deg) * 0.03
            local score = clearance - alignmentPenalty
            if score > bestClearance then
                bestClearance = score
                bestDir = testDir
            end
        end

        return bestDir.Unit
    end

    function OnyPathfinder:MonitorStuckState(hrp, goalPos)
        if not hrp or not goalPos then
            self.StuckFrames = 0
            return false
        end
        local movedDist = (hrp.Position - self.LastPosition).Magnitude
        self.LastPosition = hrp.Position
        if movedDist < 0.25 and (hrp.Position - goalPos).Magnitude > 6 then
            self.StuckFrames = self.StuckFrames + 1
        else
            self.StuckFrames = math.max(0, self.StuckFrames - 1)
        end
        if self.StuckFrames >= 12 then
            self.StuckFrames = 0
            hrp.CFrame = hrp.CFrame + Vector3.new(0, 3.8, 0)
            return true
        end
        return false
    end

