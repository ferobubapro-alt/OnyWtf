        for _, item in ipairs(group.items or {}) do
            if item.type == "checkbox" then
                GlobalEnv.OnyWtf.Flags[item.id] = (item.default == true)
            end
            if item.colors and #item.colors > 0 then
                GlobalEnv.OnyWtf.Colors[item.id] = item.colors
            end
            if item.keybind then
                GlobalEnv.OnyWtf.Keybinds[item.id] = item.keybind
            end
            if item.subSettings then
                for _, sub in ipairs(item.subSettings) do
                    GlobalEnv.OnyWtf.Values[sub.id] = sub.default
                end
            end
        end
    end
end

