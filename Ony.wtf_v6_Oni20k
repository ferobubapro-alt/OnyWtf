        local mappedCoreVal = UNI_TO_CORE_VALUE_MAP[subId]
        Values[mappedCoreVal] = newVal
        if Ony.SubValueVisualSyncCallbacks[mappedCoreVal] then
            pcall(Ony.SubValueVisualSyncCallbacks[mappedCoreVal], newVal)
        end
    end
