    function Ony.SpawnBulletImpactBeam(originPos, targetPos, beamColor)
        if not Flags["bullet_impacts"] then
            return
        end
        pcall(function()
            local dist = (targetPos - originPos).Magnitude
            local mid = (originPos + targetPos) * 0.5

            local beamPart = Instance.new("Part")
            beamPart.Name = "OnyBulletBeam"
            beamPart.Anchored = true
            beamPart.CanCollide = false
            beamPart.CanQuery = false
            beamPart.Material = Enum.Material.Neon
            beamPart.Color = beamColor or (ItemColors["bullet_impacts"] and ItemColors["bullet_impacts"][1]) or Color3.fromRGB(56, 189, 248)
            beamPart.Transparency = 0.15
            beamPart.Size = Vector3.new(0.16, 0.16, dist)
            beamPart.CFrame = CFrame.lookAt(mid, targetPos)
            beamPart.Parent = Workspace
            TrackWorldInstance(beamPart)

            local hitBox = Instance.new("Part")
            hitBox.Name = "OnyBulletImpactMarker"
            hitBox.Anchored = true
            hitBox.CanCollide = false
            hitBox.CanQuery = false
            hitBox.Material = Enum.Material.Neon
            hitBox.Color = AccentColor
            hitBox.Transparency = 0.1
            hitBox.Size = Vector3.new(1.1, 1.1, 1.1)
            hitBox.CFrame = CFrame.new(targetPos)
            hitBox.Parent = Workspace
            TrackWorldInstance(hitBox)

            task.delay(0.85, function()
                if beamPart and beamPart.Parent then
                    TweenService:Create(beamPart, TweenInfo.new(0.35), { Transparency = 1 }):Play()
                end
                if hitBox and hitBox.Parent then
                    TweenService:Create(hitBox, TweenInfo.new(0.35), { Transparency = 1, Size = Vector3.new(2.2, 2.2, 2.2) }):Play()
                end
                task.wait(0.38)
                pcall(function() beamPart:Destroy() end)
                pcall(function() hitBox:Destroy() end)
            end)
        end)
    end

    function Ony.ResolveCombatTarget(useSilentFov)
        if not Camera then
            return nil, nil, nil
        end

        if Flags["aimbot_lock_murderer"] then
            local m = Ony.GetMurdererPlayer()
            if m and m.Character then
                local part = MathEngine.ResolveHitboxPart(m.Character, Values["aimbot_hitbox"])
                if part and (not Flags["wall_check"] or MathEngine.IsPartVisible(part)) then
                    local pred = MathEngine.PredictTargetPosition(part, Values["shot_mode"], Values["shoot_y_offset"])
                    return m, part, pred
                end
            end
        end

        if Flags["aimbot_lock_sheriff"] then
            local s = Ony.GetSheriffPlayer()
            if s and s.Character then
                local part = MathEngine.ResolveHitboxPart(s.Character, Values["aimbot_hitbox"])
                if part and (not Flags["wall_check"] or MathEngine.IsPartVisible(part)) then
                    local pred = MathEngine.PredictTargetPosition(part, Values["shot_mode"], Values["shoot_y_offset"])
                    return s, part, pred
                end
            end
        end

        local myRole = Ony.ResolvePlayerRole(LocalPlayer)
        local refCenter = Camera.ViewportSize * 0.5
        local maxFovRadius = useSilentFov
            and (tonumber(Values["silent_aim_fov"]) or 180)
            or (tonumber(Values["fov_radius"]) or 110)
        local enforceFov = useSilentFov or (Values["fov_lock"] ~= false)

        local bestPlayer = nil
        local bestPart = nil
        local bestScore = math.huge

        for _, plr in ipairs(Players:GetPlayers()) do
            if plr ~= LocalPlayer and Ony.IsPlayerInActiveRound(plr) then
                local targetRole = Ony.ResolvePlayerRole(plr)
                local validTarget = true

                if (myRole == "Sheriff" or myRole == "Hero" or myRole == "Innocent") and targetRole ~= "Murderer" then
                    if Ony.GetMurdererPlayer() ~= nil then
                        validTarget = false
                    end
                end

                if validTarget and plr.Character then
                    local part = MathEngine.ResolveHitboxPart(plr.Character, Values["aimbot_hitbox"])
                    if part then
                        local visibleOk = (not Flags["wall_check"]) or MathEngine.IsPartVisible(part)
                        if visibleOk then
                            local screenPt, onScreen = MathEngine.WorldToScreen(part.Position)
                            if onScreen then
                                local pixelDist = (screenPt - refCenter).Magnitude
                                if (not enforceFov) or (pixelDist <= maxFovRadius) then
                                    local score = pixelDist
                                    if targetRole == "Murderer" then
                                        score = score - 500
                                    end
                                    if score < bestScore then
                                        bestScore = score
                                        bestPlayer = plr
                                        bestPart = part
                                    end
                                end
                            elseif not enforceFov then
                                local worldDist = MathEngine.GetDistanceFromLocal(part.Position)
                                if worldDist < bestScore then
                                    bestScore = worldDist
                                    bestPlayer = plr
                                    bestPart = part
                                end
                            end
                        end
                    end
                end
            end
        end

        if bestPlayer and bestPart then
            local pred = MathEngine.PredictTargetPosition(bestPart, Values["shot_mode"], Values["shoot_y_offset"])
            return bestPlayer, bestPart, pred
        end

        return nil, nil, nil
    end

    -- Optional __namecall Silent Aim Hook (Safely Skipped in Standard LocalScripts)
    pcall(function()
        if ExecutorCaps.HasHookMetaMethod then
            local oldNamecall
            oldNamecall = hookmetamethod(game, "__namecall", function(self, ...)
                local method = (type(getnamecallmethod) == "function" and getnamecallmethod()) or ""
                local args = { ... }

                if Flags["silent_aim_toggle"] and not (type(checkcaller) == "function" and checkcaller()) then
                    if method == "InvokeServer" and tostring(self.Name) == "RemoteFunction" and self.Parent and tostring(self.Parent.Name) == "CreateBeam" then
                        local targetPlr, targetPart, predictedPos = Ony.ResolveCombatTarget(true)
                        if targetPlr and targetPart and predictedPos then
                            args[2] = predictedPos
                            if LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart") then
                                Ony.SpawnBulletImpactBeam(LocalPlayer.Character.HumanoidRootPart.Position, predictedPos)
                            end
                            if Flags["shot_info"] then
                                task.defer(function()
                                    Ony.NotifyToast(
                                        "Silent Aim Hit",
                                        string.format("Redirected Beam -> %s (%s)", targetPlr.Name, tostring(targetPart.Name))
                                    )
                                end)
                            end
                            return oldNamecall(self, unpack(args))
                        end
                    elseif method == "FireServer" and tostring(self.Name) == "Throw" then
                        local targetPlr, targetPart, predictedPos = Ony.ResolveCombatTarget(true)
                        if targetPlr and targetPart and predictedPos then
                            if typeof(args[1]) == "CFrame" then
                                args[1] = CFrame.new(predictedPos)
                                if typeof(args[2]) == "Vector3" then
                                    args[2] = predictedPos
                                end
                            elseif typeof(args[1]) == "Vector3" then
                                args[1] = predictedPos
                            end
                            return oldNamecall(self, unpack(args))
                        end
                    end
                end

                return oldNamecall(self, ...)
            end)
        end
    end)

    function Ony.ShootMurdererWithGun(requireVisible, isInstaWin)
        local target = Ony.GetMurdererPlayer()
        if not target or not target.Character then
            if not requireVisible then
                Ony.NotifyToast("Ony.wtf Sheriff", "No active Murderer found in round!")
            end
            return false
        end

        local part = MathEngine.ResolveHitboxPart(target.Character, Values["aimbot_hitbox"])
        if not part then
            return false
        end

        if requireVisible and not MathEngine.IsPartVisible(part) then
            return false
        end

        local char = LocalPlayer.Character
        local hrp = char and char:FindFirstChild("HumanoidRootPart")
        local hum = char and char:FindFirstChildOfClass("Humanoid")
        if not char or not hrp or not hum then
            return false
        end

        local hasGun, gunTool = Ony.HasGunTool(LocalPlayer)
        if not hasGun or not gunTool then
            if not requireVisible then
                Ony.NotifyToast("Ony.wtf Sheriff", "You do not have the Sheriff Gun!")
            end
            return false
        end

        local savedCFrame = hrp.CFrame
        if isInstaWin or tostring(Values["shot_mode"]) == "Teleport Bullet" then
            hrp.CFrame = part.CFrame * CFrame.new(0, 2.5, 6.5)
            task.wait(0.05)
        end

        if gunTool.Parent ~= char then
            pcall(function()
                hum:EquipTool(gunTool)
            end)
            task.wait(0.06)
        end

        local predictedPos = MathEngine.PredictTargetPosition(part, Values["shot_mode"], Values["shoot_y_offset"])
        local createBeam = gunTool:FindFirstChild("CreateBeam", true)
        local remoteFunc = createBeam and createBeam:FindFirstChild("RemoteFunction")

        if remoteFunc and remoteFunc:IsA("RemoteFunction") then
            task.spawn(function()
                pcall(function()
                    remoteFunc:InvokeServer(1, predictedPos, "AH2")
                end)
            end)
            Ony.SpawnBulletImpactBeam(hrp.Position, predictedPos)
            if Flags["shot_info"] or not requireVisible then
                local dist = math.floor((hrp.Position - predictedPos).Magnitude)
                Ony.NotifyToast(
                    "Ony.wtf Sheriff Shot",
                    string.format("Fired at %s [%s | %d studs]", target.Name, part.Name, dist)
                )
            end
        else
            pcall(function()
                gunTool:Activate()
            end)
        end

        if isInstaWin or tostring(Values["shot_mode"]) == "Teleport Bullet" then
            task.wait(0.08)
            if hrp and hrp.Parent then
                hrp.CFrame = savedCFrame
            end
        end

        return true
    end

    function Ony.ExecuteKnifeCombat(filterRole)
        local char = LocalPlayer.Character
        local hrp = char and char:FindFirstChild("HumanoidRootPart")
        local hum = char and char:FindFirstChildOfClass("Humanoid")
        if not char or not hrp or not hum then
            return
        end

        local hasKnife, knifeTool = Ony.HasKnifeTool(LocalPlayer)
        if not hasKnife or not knifeTool then
            if filterRole then
                Ony.NotifyToast("Ony.wtf Murderer", "Knife tool not found in character or backpack!")
            end
            return
        end

        if knifeTool.Parent ~= char then
            pcall(function()
                hum:EquipTool(knifeTool)
            end)
        end

        local stabRemote = knifeTool:FindFirstChild("Stab") or knifeTool:FindFirstChild("Slash")
        local handle = knifeTool:FindFirstChild("Handle")
        local radius = tonumber(Values["kill_aura_radius"]) or 14

        for _, target in ipairs(Players:GetPlayers()) do
            if target ~= LocalPlayer and Ony.IsPlayerInActiveRound(target) and target.Character then
                local role = Ony.ResolvePlayerRole(target)
                local roleMatch = (not filterRole)
                    or (filterRole == "Sheriff" and (role == "Sheriff" or role == "Hero"))
                    or (filterRole == "Innocent" and role == "Innocent")

                local tHrp = target.Character:FindFirstChild("HumanoidRootPart")
                local tHum = target.Character:FindFirstChildOfClass("Humanoid")
                if roleMatch and tHrp and tHum and tHum.Health > 0 then
                    local dist = (hrp.Position - tHrp.Position).Magnitude
                    local inRange = (filterRole ~= nil)
                        or (Flags["auto_kill_all"] == true)
                        or (Flags["kill_aura"] == true and dist <= radius)

                    if inRange then
                        pcall(function()
                            if stabRemote and stabRemote:IsA("RemoteEvent") then
                                stabRemote:FireServer("Down")
                            else
                                knifeTool:Activate()
                            end
                        end)

                        if handle and ExecutorCaps.HasFireTouchInterest then
                            pcall(function()
                                firetouchinterest(tHrp, handle, 0)
                                firetouchinterest(tHrp, handle, 1)
                            end)
                        else
                            pcall(function()
                                tHrp.CFrame = hrp.CFrame * CFrame.new(0, 0, -2.2)
                            end)
                        end
                    end
                end
            end
        end
    end

    function Ony.ExecuteAutoThrowKnife()
