    local function ResolveSelectedTargetPlayer()
        local selection = tostring(Values["target_player_select"] or "Murderer (Auto)")
        if selection == "Murderer (Auto)" then
            return GetMurdererPlayer() or GetClosestAlivePlayerToPoint(LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart") and LocalPlayer.Character.HumanoidRootPart.Position or Vector3.zero)
        elseif selection == "Sheriff (Auto)" then
            return GetSheriffPlayer() or GetMurdererPlayer()
        elseif selection == "Closest Player" then
            local hrp = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
            if hrp then
                local p = GetClosestAlivePlayerToPoint(hrp.Position)
                return p
            end
        else
            for _, plr in ipairs(Players:GetPlayers()) do
                if plr ~= LocalPlayer and (plr.Name == selection or string.find(selection, plr.Name, 1, true)) then
                    return plr
                end
            end
        end
        return GetMurdererPlayer() or GetSheriffPlayer()
    end
    Ony.ResolveSelectedTargetPlayer = ResolveSelectedTargetPlayer

    local IsExecutingFling = false

    local function ExecuteVelocityFlingOnTarget(targetPlayer, durationSec)
        if IsExecutingFling or not targetPlayer or not targetPlayer.Character then
            return
        end
        local char = LocalPlayer.Character
        local hrp = char and char:FindFirstChild("HumanoidRootPart")
        local tHrp = targetPlayer.Character:FindFirstChild("HumanoidRootPart")
        if not hrp or not tHrp then
            return
        end

        IsExecutingFling = true
        local savedCf = hrp.CFrame
        local startT = os.clock()
        local runTime = durationSec or 0.48

        while (os.clock() - startT < runTime) and hrp.Parent and tHrp.Parent do
            local pred = tHrp.Position + (tHrp.AssemblyLinearVelocity * 0.08)
            hrp.CFrame = CFrame.new(pred) * CFrame.Angles(math.rad(math.random(-180, 180)), math.rad(math.random(-180, 180)), 0)
            hrp.AssemblyLinearVelocity = Vector3.new(9000, 9000, 9000)
            hrp.AssemblyAngularVelocity = Vector3.new(9000, 9000, 9000)
            RunService.Heartbeat:Wait()
        end

        if hrp and hrp.Parent then
            hrp.AssemblyLinearVelocity = Vector3.zero
            hrp.AssemblyAngularVelocity = Vector3.zero
            hrp.CFrame = savedCf
        end
        IsExecutingFling = false
    end
    Ony.ExecuteVelocityFlingOnTarget = ExecuteVelocityFlingOnTarget

