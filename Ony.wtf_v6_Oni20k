-- [3] B1RKT OTOMATİK OWNER ALGILAMA VE KİŞİYE ÖZEL PREFIX MOTORU
local ROOT_OWNER_USERNAME = "B1rkt"

local function ResolvePlayerRankLevel(playerOrName: Player | string): number
    local username = typeof(playerOrName) == "Instance" and (playerOrName :: Player).Name or tostring(playerOrName)
    if username == ROOT_OWNER_USERNAME or string.lower(username) == string.lower(ROOT_OWNER_USERNAME) then
        TableDB.RanksByUsername[username] = 10
        return 10
    end
    local savedLevel = TableDB.RanksByUsername[username]
    if type(savedLevel) == "number" then
        return math.clamp(savedLevel, 0, 99)
    end
    TableDB.RanksByUsername[username] = 1
    return 1
end

local function ResolvePersonalPrefix(username: string): string
    local savedPfx = TableDB.PrefixesByUsername[username]
    if type(savedPfx) == "string" and #savedPfx > 0 then
        return savedPfx
    end
    return TableDB.DefaultPrefix or ";"
end

local function GetTierData(level: number): TierDefinition
    if DEFAULT_TIERS[level] then
        return DEFAULT_TIERS[level]
    end
    local bestMatch = DEFAULT_TIERS[1]
    local highestFound = -1
    for lvl, data in pairs(DEFAULT_TIERS) do
        if level >= lvl and lvl > highestFound then
            highestFound = lvl
            bestMatch = data
        end
    end
    return bestMatch
end

