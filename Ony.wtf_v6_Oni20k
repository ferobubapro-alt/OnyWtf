-- [7] GELİŞMİŞ HEDEF OYUNCU ÇÖZÜMLEYİCİ (me, others, all, random, berks, isim, ismin başı, displayName)
local function ResolveTargetPlayers(selectorRaw: string?): { Player }
    local sel = string.lower(string.gsub(selectorRaw or State.SelectedTargetMode or "me", "^%s*(.-)%s*$", "%1"))
    local allPlayers = Players:GetPlayers()
    local results: { Player } = {}

    if sel == "" or sel == "me" or sel == "self" or sel == "ben" then
        return { LocalPlayer }
    elseif sel == "all" or sel == "everyone" or sel == "herkes" or sel == "*" then
        return allPlayers
    elseif sel == "others" or sel == "other" or sel == "digerleri" then
        for _, p in ipairs(allPlayers) do
            if p ~= LocalPlayer then
                table.insert(results, p)
            end
        end
        return results
    elseif sel == "random" or sel == "rastgele" then
        if #allPlayers > 0 then
            return { allPlayers[math.random(1, #allPlayers)] }
        end
        return {}
    elseif sel == "berks" or sel == "peers" or sel == "admins" then
        for _, p in ipairs(allPlayers) do
            if State.ActivePeers[p.Name] or p == LocalPlayer then
                table.insert(results, p)
            end
        end
        return results
    end

    for _, p in ipairs(allPlayers) do
        if string.lower(p.Name) == sel or string.lower(p.DisplayName) == sel then
            return { p }
        end
    end

    for _, p in ipairs(allPlayers) do
        if string.sub(string.lower(p.Name), 1, #sel) == sel or string.sub(string.lower(p.DisplayName), 1, #sel) == sel then
            table.insert(results, p)
        end
    end
    if #results > 0 then
        return results
    end

    for _, p in ipairs(allPlayers) do
        if string.find(string.lower(p.Name), sel, 1, true) or string.find(string.lower(p.DisplayName), sel, 1, true) then
            table.insert(results, p)
        end
    end

    return results
end

