local function SetFlagState(flagId, newState, skipMirror)
    local boolVal = (newState == true)
    Flags[flagId] = boolVal
    if Ony.FlagVisualSyncCallbacks[flagId] then
        pcall(Ony.FlagVisualSyncCallbacks[flagId], boolVal)
    end
    if not skipMirror and UNI_TO_CORE_FLAG_MAP[flagId] then
        local mappedCore = UNI_TO_CORE_FLAG_MAP[flagId]
        Flags[mappedCore] = boolVal
        if Ony.FlagVisualSyncCallbacks[mappedCore] then
            pcall(Ony.FlagVisualSyncCallbacks[mappedCore], boolVal)
        end
    end
    return boolVal
end
