    local LastSoundAlertClock = 0
    local LastSoundWorldPos = nil

    local function CheckCharacterKnifeSounds()
        if not Flags["sound_esp"] then
            LastSoundWorldPos = nil
            return
        end
        for _, plr in ipairs(Players:GetPlayers()) do
            if plr ~= LocalPlayer and plr.Character then
                for _, desc in ipairs(plr.Character:GetDescendants()) do
                    if desc:IsA("Sound") and desc.IsPlaying then
                        local sName = string.lower(tostring(desc.Name))
                        if string.find(sName, "slash") or string.find(sName, "stab") or string.find(sName, "equip") or string.find(sName, "throw") or (desc.Parent and desc.Parent.Parent and desc.Parent.Parent.Name == "Knife") then
                            local hrp = plr.Character:FindFirstChild("HumanoidRootPart")
                            if hrp then
                                LastSoundWorldPos = hrp.Position
                                if os.clock() - LastSoundAlertClock > 2.2 then
                                    LastSoundAlertClock = os.clock()
                                    NotifyToast("Sound ESP Alert", "Knife audio detected from " .. plr.Name .. "!", Color3.fromRGB(255, 42, 75))
                                end
                            end
                        end
                    end
                end
            end
        end
    end
