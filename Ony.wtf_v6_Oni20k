    local WindowScale = Instance.new("UIScale", MainWindow)
    local TargetViewportScale = 1
    local function ComputeTargetViewportScale()
        if not Camera then
            return 1
        end
        local vp = Camera.ViewportSize
        if vp.Y < 530 or vp.X < 760 then
            local sx = (vp.X - 32) / 720
            local sy = (vp.Y - 32) / 470
            return MathEngine.Clamp(math.min(sx, sy), 0.55, 1)
        end
        return 1
    end
    local function UpdateViewportScale()
        TargetViewportScale = ComputeTargetViewportScale()
        WindowScale.Scale = TargetViewportScale
    end
    UpdateViewportScale()
    if Camera then
        TrackConnection(Camera:GetPropertyChangedSignal("ViewportSize"):Connect(UpdateViewportScale))
    end

    local MenuAnimating = false
    local function OpenMenuSmooth()
        if MenuAnimating then
            return
        end
        MenuAnimating = true
        TargetViewportScale = ComputeTargetViewportScale()
        FloatingToggleBtn.Visible = false
        MainWindow.Visible = true
        WindowScale.Scale = TargetViewportScale * 0.78
        pcall(function()
            TweenService:Create(
                WindowScale,
                TweenInfo.new(0.28, Enum.EasingStyle.Back, Enum.EasingDirection.Out),
                { Scale = TargetViewportScale }
            ):Play()
        end)
        task.delay(0.29, function()
            WindowScale.Scale = TargetViewportScale
            MenuAnimating = false
        end)
    end

    local function MinimizeMenuSmooth()
        if MenuAnimating then
            return
        end
        MenuAnimating = true
        TargetViewportScale = ComputeTargetViewportScale()
        pcall(function()
            TweenService:Create(
                WindowScale,
                TweenInfo.new(0.18, Enum.EasingStyle.Back, Enum.EasingDirection.In),
                { Scale = TargetViewportScale * 0.68 }
            ):Play()
        end)
        task.delay(0.18, function()
            MainWindow.Visible = false
            WindowScale.Scale = TargetViewportScale
            FloatingToggleBtn.Visible = true
