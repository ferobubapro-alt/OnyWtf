    function MenuCustomizer:AttachGuiOniDemonCrest(parentHolder, zBase, styleOverride, primaryOverride, secondaryOverride, doNotTrack)
        if not parentHolder or not Ony.CreateGuiLine or not Ony.SetGuiLine then return nil end
        local z = zBase or (parentHolder.ZIndex + 3)
        local styleId = styleOverride or self.LogoStyle or "oni_crimson"
        local pCol = primaryOverride or Ony.AccentColor or Color3.fromRGB(255, 59, 154)
        local sCol = secondaryOverride or self.LogoSecondaryColor or Color3.fromRGB(0, 210, 255)

        if not primaryOverride then
            if styleId == "oni_cyber" then
                pCol = Color3.fromRGB(0, 245, 212)
                sCol = Color3.fromRGB(0, 210, 255)
            elseif styleId == "oni_abyssal" then
                pCol = Color3.fromRGB(168, 85, 247)
                sCol = Color3.fromRGB(255, 59, 154)
            elseif styleId == "oni_shogun" then
                pCol = Color3.fromRGB(245, 158, 11)
                sCol = Color3.fromRGB(239, 68, 68)
            end
        end

        -- Clear previous Oni crest segments inside parentHolder if re-rendering
        for _, ch in ipairs(parentHolder:GetChildren()) do
            if ch.Name == "OniVectorLineSeg" then
                ch:Destroy()
            end
        end

        local w = parentHolder.Size.X.Offset > 0 and parentHolder.Size.X.Offset or parentHolder.AbsoluteSize.X
        local h = parentHolder.Size.Y.Offset > 0 and parentHolder.Size.Y.Offset or parentHolder.AbsoluteSize.Y
        if w <= 0 then w = 36 end
        if h <= 0 then h = 36 end
        local cx, cy = w * 0.5, h * 0.5
        local r = math.min(w, h) * 0.36

        local hornSpread = (styleId == "oni_cyber") and 0.92 or ((styleId == "oni_shogun") and 0.86 or 0.74)
        local hornHeight = (styleId == "oni_abyssal") and 1.04 or 0.92

        local segDefs = {
            -- Left & Right Curved Oni Demon Horns
            { Vector2.new(cx - r * 0.28, cy - r * 0.24), Vector2.new(cx - r * hornSpread, cy - r * hornHeight), 2.2, pCol },
            { Vector2.new(cx - r * hornSpread, cy - r * hornHeight), Vector2.new(cx - r * 0.14, cy - r * 0.48), 1.8, sCol },
            { Vector2.new(cx + r * 0.28, cy - r * 0.24), Vector2.new(cx + r * hornSpread, cy - r * hornHeight), 2.2, pCol },
            { Vector2.new(cx + r * hornSpread, cy - r * hornHeight), Vector2.new(cx + r * 0.14, cy - r * 0.48), 1.8, sCol },
            -- Fierce Slanted Oni Demon Eyes
            { Vector2.new(cx - r * 0.54, cy - r * 0.15), Vector2.new(cx - r * 0.12, cy + r * 0.04), 2.2, sCol },
            { Vector2.new(cx + r * 0.54, cy - r * 0.15), Vector2.new(cx + r * 0.12, cy + r * 0.04), 2.2, sCol },
            -- Demon Jawline & Lower Fangs / Tusks
            { Vector2.new(cx - r * 0.58, cy + r * 0.18), Vector2.new(cx, cy + r * 0.76), 1.8, pCol },
            { Vector2.new(cx + r * 0.58, cy + r * 0.18), Vector2.new(cx, cy + r * 0.76), 1.8, pCol },
            { Vector2.new(cx - r * 0.46, cy + r * 0.44), Vector2.new(cx - r * 0.26, cy + r * 0.06), 2.0, Color3.fromRGB(255, 255, 255) },
            { Vector2.new(cx + r * 0.46, cy + r * 0.44), Vector2.new(cx + r * 0.26, cy + r * 0.06), 2.0, Color3.fromRGB(255, 255, 255) },
            -- Forehead Third-Eye / Shogun Crown Crest
            { Vector2.new(cx, cy - r * 0.58), Vector2.new(cx - r * 0.16, cy - r * 0.30), 1.5, pCol },
            { Vector2.new(cx, cy - r * 0.58), Vector2.new(cx + r * 0.16, cy - r * 0.30), 1.5, pCol },
        }

        local oniSegs = {}
        for idx, def in ipairs(segDefs) do
            local ln = Ony.CreateGuiLine(parentHolder, def[3], def[4], z)
            ln.Name = "OniVectorLineSeg"
            Ony.SetGuiLine(ln, def[1], def[2], def[3], def[4], 0)
            oniSegs[idx] = ln
        end

        if not doNotTrack then
            local alreadyTracked = false
            for _, entry in ipairs(self.AttachedHolders) do
                if entry.holder == parentHolder then
                    entry.zBase = z
                    alreadyTracked = true
                    break
                end
            end
            if not alreadyTracked then
                table.insert(self.AttachedHolders, { holder = parentHolder, zBase = z })
            end
        end

        return oniSegs
    end

