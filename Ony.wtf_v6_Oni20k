        end
        if dpState.targetItemId and ItemColors[dpState.targetItemId] then
            ItemColors[dpState.targetItemId][dpState.targetSwatchIdx] = col
        end
        if dpState.customCallback then
            pcall(dpState.customCallback, col, hx)
        end
    end

