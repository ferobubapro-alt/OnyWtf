Ony.RunSection("Section 9: Master Runtime Schedulers (RenderStepped, Stepped, Heartbeat)", function()
    local TrackConnection = Ony.TrackConnection
    local SetGuiLine = Ony.SetGuiLine
    local NotifyToast = Ony.NotifyToast
    local SetFlagState = Ony.SetFlagState
    local ResolvePlayerRole = Ony.ResolvePlayerRole
    local GetRoleColor = Ony.GetRoleColor
    local GetMurdererPlayer = Ony.GetMurdererPlayer
    local GetSheriffPlayer = Ony.GetSheriffPlayer
    local GetPlayerWeaponLabel = Ony.GetPlayerWeaponLabel
    local IsPlayerInActiveRound = Ony.IsPlayerInActiveRound
    local FindActiveMap = Ony.FindActiveMap
    local ResolveCombatTarget = Ony.ResolveCombatTarget

    local SpinAngle = 0
    local HueCounter = 0
    local OrbitAngle = 0
    local WatermarkOffsetCounter = 0
    local SpectatingActive = false
    local WalkSpeedModified = false
    local JumpPowerModified = false
    local GravityModified = false
    local CameraFovModified = false
    local NoclipModified = false
    local FakeLagCounter = 0

    -- // 9.1 High-Frequency RenderStepped Loop (ESP, Chams, Skeleton, 3D Box, Arrows, Crosshair, Camera Aimbot)
    TrackConnection(RunService.RenderStepped:Connect(function(dt)
        Telemetry.FPS = math.floor(1 / math.max(dt, 0.001))
        SpinAngle = (SpinAngle + dt * 4.2) % (math.pi * 2)
        HueCounter = (HueCounter + dt * 0.22) % 1
        OrbitAngle = (OrbitAngle + dt * 3.6) % (math.pi * 2)
        WatermarkOffsetCounter = (WatermarkOffsetCounter + dt * 34) % 1700

        local rainbowColor = Color3.fromHSV(HueCounter, 0.85, 1)
        local dynamicCrosshairColor = Flags["cycle_crosshair_color"]
            and rainbowColor
            or ((ItemColors["custom_crosshair"] and ItemColors["custom_crosshair"][1]) or Ony.AccentColor)

        -- Animate Splash Multi-Ring Vector Crest while Splash exists
        if Ony.SplashFrame and Ony.SplashFrame.Parent then
            Ony.SplashInnerDiamond.Rotation = math.deg(SpinAngle)
            if Ony.SplashOctaA then
                Ony.SplashOctaA.Rotation = -math.deg(SpinAngle * 0.7)
            end
            if Ony.SplashOctaB then
                Ony.SplashOctaB.Rotation = 45 + math.deg(SpinAngle * 0.5)
            end
            for i, d in ipairs(Ony.SplashVectorDots) do
                local a = SpinAngle * 0.65 + (i * math.pi * 2) / #Ony.SplashVectorDots
                local r = 29 + math.sin(SpinAngle * 2 + i) * 2.5
                d.Position = UDim2.fromOffset(37 + math.cos(a) * r, 37 + math.sin(a) * r)
            end
        end

        -- Animate Draggable Minimized Vector Logo Button while visible
        if Ony.FloatingToggleBtn and Ony.FloatingToggleBtn.Visible then
            if Ony.FloatCoreDiamond then
                Ony.FloatCoreDiamond.Rotation = 45 + math.deg(SpinAngle * 0.9)
            end
            if Ony.FloatOctaA then
                Ony.FloatOctaA.Rotation = math.deg(SpinAngle * 0.55)
            end
            if Ony.FloatOctaB then
                Ony.FloatOctaB.Rotation = 45 - math.deg(SpinAngle * 0.75)
            end
            if Ony.FloatOrbitDots then
                for i, fd in ipairs(Ony.FloatOrbitDots) do
                    local a = -SpinAngle * 0.85 + (i * math.pi * 2) / #Ony.FloatOrbitDots
                    local r = 20 + math.sin(SpinAngle * 2.2 + i) * 1.5
                    fd.Position = UDim2.fromOffset(27 + math.cos(a) * r, 27 + math.sin(a) * r)
                end
            end
        end

        -- Animate Moving Pink "Ony.wtf" Background Watermarks inside MainWindow
        if Ony.WatermarkHolder and Ony.MainWindow and Ony.MainWindow.Visible then
            local driftX = (WatermarkOffsetCounter % 170)
            local driftY = ((WatermarkOffsetCounter * 0.65) % 72)
            Ony.WatermarkHolder.Position = UDim2.fromOffset(-260 + driftX, -195 + driftY)
            for wIdx, wmLbl in ipairs(Ony.WatermarkLabels) do
                wmLbl.TextTransparency = 0.83 + math.sin(SpinAngle * 0.9 + (wIdx % 6) * 0.5) * 0.05
            end
        end

        -- Animate Header Crest, Octagram Ring, Letter Wave & Rainbow Bar
        Ony.HeaderInnerCrest.Rotation = math.deg(SpinAngle)
        if Ony.HeaderOctaRing then
            Ony.HeaderOctaRing.Rotation = -math.deg(SpinAngle * 0.65)
        end
        Ony.RainbowGradient.Offset = Vector2.new((HueCounter * 2) - 1, 0)
        for idx, item in ipairs(Ony.TitleLetters) do
            local waveY = math.sin(SpinAngle * 1.4 + idx * 0.55) * 2
            item.label.Position = UDim2.fromOffset(item.baseX, waveY)
        end

        if not Camera then
            return
        end
        local vpCenter = Camera.ViewportSize * 0.5

        -- 1. Update Dynamic Island HUD
        if Flags["dynamic_island_hud"] then
            Ony.DynamicIslandFrame.Visible = true
            Ony.DynamicIslandStroke.Color = Flags["cycle_crosshair_color"] and rainbowColor or Ony.AccentColor
            Ony.DynamicIslandText.Text = string.format(
                "Ony.wtf | Role: %s | M: %s | S: %s | Coins: %d/%d | %d FPS",
                tostring(Telemetry.CurrentRole),
                tostring(Telemetry.MurdererName),
                tostring(Telemetry.SheriffName),
                Telemetry.CoinsCollected,
                Telemetry.BagCapacity,
                Telemetry.FPS
            )
        else
            Ony.DynamicIslandFrame.Visible = false
        end

        -- 2. Update Custom Vector Crosshair
        local showCh = (Flags["custom_crosshair"] == true)
        local chGap = tonumber(Values["crosshair_gap"]) or 5
        local chSize = tonumber(Values["crosshair_size"]) or 15
        local chThick = tonumber(Values["crosshair_thickness"]) or 2
        local baseAngle = Flags["spinning_crosshair"] and SpinAngle or 0

        for i = 1, 4 do
            local seg = Ony.CrosshairSegments[i]
            local dLine = Ony.DrawingCrosshairLines[i]
            if showCh then
                local theta = baseAngle + (i - 1) * (math.pi * 0.5)
                local dir = Vector2.new(math.cos(theta), math.sin(theta))
                local pStart = vpCenter + dir * chGap
                local pEnd = vpCenter + dir * (chGap + chSize)
                SetGuiLine(seg, pStart, pEnd, chThick, dynamicCrosshairColor)
                if dLine then
                    pcall(function()
                        dLine.From = pStart
                        dLine.To = pEnd
                        dLine.Thickness = chThick
                        dLine.Color = dynamicCrosshairColor
                        dLine.Visible = true
                    end)
                end
            else
                seg.Visible = false
                if dLine then
                    pcall(function()
                        dLine.Visible = false
                    end)
                end
            end
        end
        Ony.CrosshairDot.Visible = showCh and (Values["center_dot"] ~= false)
        Ony.CrosshairDot.Position = UDim2.fromOffset(vpCenter.X, vpCenter.Y)
        Ony.CrosshairDot.BackgroundColor3 = dynamicCrosshairColor

        -- 3. Update Aimbot & Silent Aim FOV Circles
        local fovR = tonumber(Values["fov_radius"]) or 110
        Ony.AimbotFOVRing.Visible = (Flags["show_fov"] == true)
        Ony.AimbotFOVRing.Position = UDim2.fromOffset(vpCenter.X, vpCenter.Y)
        Ony.AimbotFOVRing.Size = UDim2.fromOffset(fovR * 2, fovR * 2)
        Ony.AimbotFOVStroke.Color = (ItemColors["show_fov"] and ItemColors["show_fov"][1]) or Ony.AccentColor

        local sFovR = tonumber(Values["silent_aim_fov"]) or 180
        Ony.SilentFOVRing.Visible = (Flags["silent_aim_toggle"] == true)
        Ony.SilentFOVRing.Position = UDim2.fromOffset(vpCenter.X, vpCenter.Y)
        Ony.SilentFOVRing.Size = UDim2.fromOffset(sFovR * 2, sFovR * 2)
        Ony.SilentFOVStroke.Color = (ItemColors["silent_aim_toggle"] and ItemColors["silent_aim_toggle"][1]) or Color3.fromRGB(0, 210, 255)

        -- 4. Update 3D Kill Aura Circle Around LocalPlayer
        local showAuraCircle = Flags["kill_aura"] and (Values["show_kill_aura_radius"] ~= false)
        local localHrp = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
        if showAuraCircle and localHrp then
            local auraRad = tonumber(Values["kill_aura_radius"]) or 14
            local auraCol = (ItemColors["kill_aura"] and ItemColors["kill_aura"][1]) or Color3.fromRGB(255, 42, 75)
            for i = 1, 16 do
                local a1 = ((i - 1) / 16) * (math.pi * 2)
                local a2 = (i / 16) * (math.pi * 2)
                local w1 = localHrp.Position + Vector3.new(math.cos(a1) * auraRad, -2.5, math.sin(a1) * auraRad)
                local w2 = localHrp.Position + Vector3.new(math.cos(a2) * auraRad, -2.5, math.sin(a2) * auraRad)
                local s1, on1 = MathEngine.WorldToScreen(w1)
                local s2, on2 = MathEngine.WorldToScreen(w2)
                if on1 and on2 then
                    SetGuiLine(Ony.KillAuraSegments[i], s1, s2, 1.6, auraCol)
                else
                    Ony.KillAuraSegments[i].Visible = false
                end
            end
        else
            for i = 1, 16 do
                Ony.KillAuraSegments[i].Visible = false
            end
        end

        -- 5. Update Parabolic Knife Throw Arc Preview (penetration_preview)
        if Flags["penetration_preview"] and localHrp then
            local arcCol = (ItemColors["penetration_preview"] and ItemColors["penetration_preview"][1]) or Color3.fromRGB(251, 191, 36)
            local pts, hitPos = MathEngine.ComputeKnifeThrowArc(
                localHrp.Position + Vector3.new(0, 1.5, 0),
                Camera.CFrame.LookVector,
                115,
                Workspace.Gravity * 0.45,
                16
            )
            for i = 1, 16 do
                local pA = pts[i]
                local pB = pts[i + 1]
                if pA and pB then
                    local sA, onA = MathEngine.WorldToScreen(pA)
                    local sB, onB = MathEngine.WorldToScreen(pB)
                    if onA and onB then
                        SetGuiLine(Ony.KnifeArcSegments[i], sA, sB, 1.8, arcCol)
                    else
                        Ony.KnifeArcSegments[i].Visible = false
                    end
                else
                    Ony.KnifeArcSegments[i].Visible = false
                end
            end
            if hitPos then
                local sh, onH = MathEngine.WorldToScreen(hitPos)
                Ony.KnifeArcLandingDot.Visible = onH
                if onH then
                    Ony.KnifeArcLandingDot.Position = UDim2.fromOffset(sh.X, sh.Y)
                    Ony.KnifeArcLandingDot.BackgroundColor3 = arcCol
                    Ony.KnifeArcLandingStroke.Color = arcCol
                end
            else
                Ony.KnifeArcLandingDot.Visible = false
            end
        else
            for i = 1, 16 do
                Ony.KnifeArcSegments[i].Visible = false
            end
            Ony.KnifeArcLandingDot.Visible = false
        end

        -- 6. Update Murderer Line of Sight Laser (line_of_sight)
        if Flags["line_of_sight"] then
            local murderer = GetMurdererPlayer()
            local mHead = murderer and murderer.Character and murderer.Character:FindFirstChild("Head")
            if mHead then
                local startW = mHead.Position
                local endW = startW + (mHead.CFrame.LookVector * 45)
                local s1, on1 = MathEngine.WorldToScreen(startW)
                local s2, on2 = MathEngine.WorldToScreen(endW)
                if on1 and on2 then
                    SetGuiLine(Ony.MurdererLoSLine, s1, s2, 2.0, Color3.fromRGB(255, 42, 75))
                else
                    Ony.MurdererLoSLine.Visible = false
                end
            else
                Ony.MurdererLoSLine.Visible = false
            end
        else
            Ony.MurdererLoSLine.Visible = false
        end

        -- 7. Camera Aimbot, Lock Murderer/Sheriff & Spectate Target
        local anyAimbotActive = Flags["enable_aimbot"]
            or Flags["lock_camera"]
            or Flags["aimbot_lock_murderer"]
            or Flags["aimbot_lock_sheriff"]

        if anyAimbotActive then
            local mode = tostring(Values["aimbot_mode"] or "Always Active")
            local modeAllowed = true
            if mode == "Hold Key" then
                modeAllowed = UserInputService:IsKeyDown(Enum.KeyCode.Q) or UserInputService:IsMouseButtonPressed(Enum.UserInputType.MouseButton2)
            elseif mode == "Toggle Key" then
                modeAllowed = Ony.AimbotToggleKeyState
            end

            if modeAllowed then
                local targetPlr, targetPart, predictedPos = ResolveCombatTarget(false)
                Ony.CurrentLockedTarget = targetPlr
                if targetPart and predictedPos then
                    local smoothness = MathEngine.Clamp(tonumber(Values["aimbot_speed"]) or 2, 1, 20)
                    local alpha = Flags["lock_camera"] and 0.85 or MathEngine.Clamp(1 / smoothness, 0.06, 1)
                    local goalCf = CFrame.lookAt(Camera.CFrame.Position, predictedPos)
                    Camera.CFrame = Camera.CFrame:Lerp(goalCf, alpha)
                end
            end
        else
            Ony.CurrentLockedTarget = nil
        end

        -- Spectate Locked Target
        if Flags["spectate_target"] then
            local specPlr = Ony.CurrentLockedTarget or GetMurdererPlayer() or GetSheriffPlayer()
            local specHum = specPlr and specPlr.Character and specPlr.Character:FindFirstChildOfClass("Humanoid")
            if specHum then
                SpectatingActive = true
                Camera.CameraSubject = specHum
            end
        elseif SpectatingActive then
            SpectatingActive = false
            local myHum = LocalPlayer.Character and LocalPlayer.Character:FindFirstChildOfClass("Humanoid")
            if myHum then
                Camera.CameraSubject = myHum
            end
        end

        -- 8. Update World Items ESP (GunDrop, CoinContainer, Traps, Sound ESP)
        Ony.UpdateWorldItemsESP(vpCenter, dynamicCrosshairColor)

        -- 9. Update Per-Player ESP, Chams, Skeleton, 3D/Corner/2D Boxes, Tracers & Off-Screen Arrows
        local maxEspDist = tonumber(Values["max_esp_distance"]) or 2500
        local hideDeadOrLobby = (Flags["filter_hide_dead"] == true)

        for _, plr in ipairs(Players:GetPlayers()) do
            if plr ~= LocalPlayer then
                local pack = Ony.CreatePlayerESPPack(plr)
                local char = plr.Character
                local hrp = char and char:FindFirstChild("HumanoidRootPart")
                local hum = char and char:FindFirstChildOfClass("Humanoid")
                local worldDist = hrp and MathEngine.GetDistanceFromLocal(hrp.Position) or math.huge

                local shouldRenderPlayer = (char ~= nil)
                    and (hrp ~= nil)
                    and (hum ~= nil)
                    and (hum.Health > 0)
                    and (worldDist <= maxEspDist)
                    and (not hideDeadOrLobby or IsPlayerInActiveRound(plr))

                if shouldRenderPlayer then
                    local role = ResolvePlayerRole(plr)
                    local roleCol = (Values["rainbow_chams"] == true) and rainbowColor or GetRoleColor(role)

                    -- Role Highlight / Chams & Contact Glow
                    local roleSpecificEnabled = (role == "Murderer" and Flags["role_murderer_esp"])
                        or (role == "Sheriff" and Flags["role_sheriff_esp"])
                        or (role == "Hero" and Flags["role_hero_esp"])
                        or (role == "Innocent" and Flags["role_innocent_esp"])
                    local contactNear = Flags["contact_glow"] and (worldDist <= 22)
                    local shouldHighlight = Flags["chams"] or roleSpecificEnabled or contactNear

                    local hl = char:FindFirstChild("OnyWtfChams")
                    if shouldHighlight then
                        if not hl then
                            hl = Instance.new("Highlight")
                            hl.Name = "OnyWtfChams"
                            hl.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
                            hl.Parent = char
                        end
                        local fillCol = contactNear
                            and ((ItemColors["contact_glow"] and ItemColors["contact_glow"][1]) or Color3.fromRGB(251, 113, 133))
                            or roleCol
                        hl.FillColor = fillCol
                        hl.OutlineColor = Color3.fromRGB(255, 255, 255)
                        hl.FillTransparency = 1 - ((tonumber(Values["chams_fill_opacity"]) or 45) / 100)
                        hl.OutlineTransparency = 1 - ((tonumber(Values["chams_outline_opacity"]) or 100) / 100)
                    elseif hl then
                        hl:Destroy()
                    end

                    -- 3D Billboard Head Tag
                    Ony.UpdatePlayerBillboardHeadTag(plr, char, role, roleCol)

                    local screenPos, onScreen, depthZ = MathEngine.WorldToScreen(hrp.Position)
                    if onScreen and depthZ > 0 then
                        -- Hide Off-Screen Arrow when player is on screen
                        pack.ArrowEdge1.Visible = false
                        pack.ArrowEdge2.Visible = false
                        pack.ArrowEdge3.Visible = false
                        if pack.DrawingTriangle then
                            pcall(function() pack.DrawingTriangle.Visible = false end)
                        end

                        local scale = 2000 / math.max(depthZ, 1)
                        local bw = MathEngine.Clamp(scale * 1.85, 18, 240)
                        local bh = MathEngine.Clamp(scale * 2.85, 28, 360)
                        local tlX = screenPos.X - bw * 0.5
                        local tlY = screenPos.Y - bh * 0.5

                        -- A. Box ESP (Corner / Full 2D / Three-Dimensional)
                        local showBox = (Flags["box_esp"] == true)
                        local boxStyle = tostring(Values["box_style"] or "Corner")
                        local boxStrokeCol = (ItemColors["box_esp"] and ItemColors["box_esp"][2]) or roleCol
                        local boxFillCol = (ItemColors["box_esp"] and ItemColors["box_esp"][1]) or Color3.fromRGB(107, 45, 92)
                        local fillAlpha = 1 - ((tonumber(Values["box_fill_opacity"]) or 15) / 100)

                        if showBox then
                            pack.BoxFrame.Position = UDim2.fromOffset(tlX, tlY)
                            pack.BoxFrame.Size = UDim2.fromOffset(bw, bh)
                            pack.BoxFrame.BackgroundColor3 = boxFillCol
                            pack.BoxFrame.BackgroundTransparency = (Values["box_fill"] ~= false) and fillAlpha or 1

                            if boxStyle == "Full 2D" then
                                pack.BoxFrame.Visible = true
                                pack.BoxStroke.Enabled = true
                                pack.BoxStroke.Color = boxStrokeCol
                                for i = 1, 8 do pack.CornerLines[i].Visible = false end
                                for i = 1, 12 do pack.Box3DLines[i].Visible = false end
                            elseif boxStyle == "Corner" then
                                pack.BoxFrame.Visible = (Values["box_fill"] ~= false)
                                pack.BoxStroke.Enabled = false
                                for i = 1, 12 do pack.Box3DLines[i].Visible = false end

                                local cLen = math.max(5, math.min(bw, bh) * 0.25)
                                local tl = Vector2.new(tlX, tlY)
                                local tr = Vector2.new(tlX + bw, tlY)
                                local bl = Vector2.new(tlX, tlY + bh)
                                local br = Vector2.new(tlX + bw, tlY + bh)

                                SetGuiLine(pack.CornerLines[1], tl, tl + Vector2.new(cLen, 0), 1.7, boxStrokeCol)
                                SetGuiLine(pack.CornerLines[2], tl, tl + Vector2.new(0, cLen), 1.7, boxStrokeCol)
                                SetGuiLine(pack.CornerLines[3], tr, tr - Vector2.new(cLen, 0), 1.7, boxStrokeCol)
                                SetGuiLine(pack.CornerLines[4], tr, tr + Vector2.new(0, cLen), 1.7, boxStrokeCol)
                                SetGuiLine(pack.CornerLines[5], bl, bl + Vector2.new(cLen, 0), 1.7, boxStrokeCol)
                                SetGuiLine(pack.CornerLines[6], bl, bl - Vector2.new(0, cLen), 1.7, boxStrokeCol)
                                SetGuiLine(pack.CornerLines[7], br, br - Vector2.new(cLen, 0), 1.7, boxStrokeCol)
                                SetGuiLine(pack.CornerLines[8], br, br - Vector2.new(0, cLen), 1.7, boxStrokeCol)
                            else
                                -- Three-Dimensional 12-Edge Wireframe Box
                                pack.BoxFrame.Visible = false
                                for i = 1, 8 do pack.CornerLines[i].Visible = false end
                                local corners = MathEngine.Get3DBoundingBoxCorners(hrp.CFrame, Vector3.new(4.2, 5.8, 2.4))
                                for eIdx, pair in ipairs(MathEngine.Box3DEdgePairs) do
                                    local sA, onA = MathEngine.WorldToScreen(corners[pair[1]])
                                    local sB, onB = MathEngine.WorldToScreen(corners[pair[2]])
                                    if onA and onB then
                                        SetGuiLine(pack.Box3DLines[eIdx], sA, sB, 1.4, boxStrokeCol)
                                    else
                                        pack.Box3DLines[eIdx].Visible = false
                                    end
                                end
                            end
                        else
                            pack.BoxFrame.Visible = false
                            for i = 1, 8 do pack.CornerLines[i].Visible = false end
                            for i = 1, 12 do pack.Box3DLines[i].Visible = false end
                        end

                        -- B. Health Bar
                        if Flags["health_bar"] then
                            local hpRatio = MathEngine.Clamp(hum.Health / math.max(hum.MaxHealth, 1), 0, 1)
                            pack.HealthBg.Visible = true
                            pack.HealthBg.Position = UDim2.fromOffset(tlX - 6, tlY)
                            pack.HealthBg.Size = UDim2.fromOffset(3, bh)
                            pack.HealthFill.Size = UDim2.new(1, 0, hpRatio, 0)
                            pack.HealthFill.BackgroundColor3 = Color3.fromRGB(239, 68, 68):Lerp(Color3.fromRGB(34, 197, 94), hpRatio)
                        else
                            pack.HealthBg.Visible = false
                        end

                        -- C. Name ESP & Role Tag
                        if Flags["name_esp"] then
                            pack.NameLabel.Visible = true
                            pack.NameLabel.Position = UDim2.fromOffset(screenPos.X, tlY - 3)
                            pack.NameLabel.TextSize = tonumber(Values["esp_text_size"]) or 13
                            pack.NameLabel.TextColor3 = (ItemColors["name_esp"] and ItemColors["name_esp"][1]) or roleCol
                            local prefix = (Values["show_role_tag"] ~= false) and ("[" .. string.upper(role) .. "] ") or ""
                            pack.NameLabel.Text = prefix .. plr.Name
                        else
                            pack.NameLabel.Visible = false
                        end

                        -- D. Weapon ESP & Distance Studs
                        if Flags["weapon_esp"] then
                            pack.WeaponLabel.Visible = true
                            pack.WeaponLabel.Position = UDim2.fromOffset(screenPos.X, tlY + bh + 2)
                            pack.WeaponLabel.TextColor3 = (ItemColors["weapon_esp"] and ItemColors["weapon_esp"][1]) or Color3.fromRGB(255, 119, 204)
                            local wStr = GetPlayerWeaponLabel(plr)
                            if Values["show_distance"] ~= false then
                                wStr = wStr .. string.format(" [%dm]", math.floor(worldDist))
                            end
                            pack.WeaponLabel.Text = wStr
                        else
                            pack.WeaponLabel.Visible = false
                        end

                        -- E. Side Flags ESP (Role, Distance, Speed)
                        if Flags["flags_esp"] then
                            pack.FlagsLabel.Visible = true
                            pack.FlagsLabel.Position = UDim2.fromOffset(tlX + bw + 5, tlY)
                            pack.FlagsLabel.TextColor3 = roleCol
                            local velMag = math.floor((hrp.AssemblyLinearVelocity or Vector3.zero).Magnitude)
                            pack.FlagsLabel.Text = string.format("%s | %dm | %d s/s", string.upper(role), math.floor(worldDist), velMag)
                        else
                            pack.FlagsLabel.Visible = false
                        end

                        -- F. Skeleton ESP (R15 & R6 Bone Segments)
                        if Flags["skeleton_esp"] then
                            local skelCol = (ItemColors["skeleton_esp"] and ItemColors["skeleton_esp"][2]) or Color3.fromRGB(255, 255, 255)
                            local skelThick = tonumber(Values["skeleton_thickness"]) or 1.5
                            local segs = MathEngine.GetCharacterBoneSegments(char)
                            for bIdx = 1, 14 do
                                local segData = segs[bIdx]
                                if segData then
                                    SetGuiLine(pack.SkeletonLines[bIdx], segData.A, segData.B, skelThick, skelCol)
                                else
                                    pack.SkeletonLines[bIdx].Visible = false
                                end
                            end
                        else
                            for bIdx = 1, 14 do
                                pack.SkeletonLines[bIdx].Visible = false
                            end
                        end

                        -- G. Tracers (Bottom / Center / Mouse)
                        if Flags["tracers"] then
                            local originMode = tostring(Values["tracer_origin"] or "Bottom")
                            local originPt = Vector2.new(vpCenter.X, Camera.ViewportSize.Y - 16)
                            if originMode == "Center" then
                                originPt = vpCenter
                            elseif originMode == "Mouse" then
                                originPt = UserInputService:GetMouseLocation()
                            end
                            local trCol = (ItemColors["tracers"] and ItemColors["tracers"][1]) or roleCol
                            SetGuiLine(pack.TracerLine, originPt, Vector2.new(screenPos.X, tlY + bh), 1.2, trCol)
                        else
                            pack.TracerLine.Visible = false
                        end

                        -- H. Extrapolation Chams (Predicted Velocity Ghost Position)
                        if Flags["extrapolation_chams"] then
                            local vel = hrp.AssemblyLinearVelocity or Vector3.zero
                            if vel.Magnitude > 2 then
                                local futurePos = hrp.Position + (vel * 0.24)
                                local fScr, fOn = MathEngine.WorldToScreen(futurePos)
                                if fOn then
                                    local exCol = (ItemColors["extrapolation_chams"] and ItemColors["extrapolation_chams"][1]) or Color3.fromRGB(56, 189, 248)
                                    pack.ExtrapFrame.Visible = true
                                    pack.ExtrapFrame.Position = UDim2.fromOffset(fScr.X, fScr.Y)
                                    pack.ExtrapFrame.BackgroundColor3 = exCol
                                    pack.ExtrapStroke.Color = exCol
                                    SetGuiLine(pack.ExtrapLine, screenPos, fScr, 1.3, exCol)
                                else
                                    pack.ExtrapFrame.Visible = false
                                    pack.ExtrapLine.Visible = false
                                end
                            else
                                pack.ExtrapFrame.Visible = false
                                pack.ExtrapLine.Visible = false
                            end
                        else
                            pack.ExtrapFrame.Visible = false
                            pack.ExtrapLine.Visible = false
                        end
                    else
                        -- Player is Off-Screen: Hide On-Screen Elements & Render Out-of-View Arrow if Enabled
                        pack.BoxFrame.Visible = false
                        pack.HealthBg.Visible = false
                        pack.NameLabel.Visible = false
                        pack.WeaponLabel.Visible = false
                        pack.FlagsLabel.Visible = false
                        pack.TracerLine.Visible = false
                        pack.ExtrapFrame.Visible = false
                        pack.ExtrapLine.Visible = false
                        for i = 1, 8 do pack.CornerLines[i].Visible = false end
                        for i = 1, 12 do pack.Box3DLines[i].Visible = false end
                        for i = 1, 14 do pack.SkeletonLines[i].Visible = false end

                        if Flags["out_of_view_arrow"] then
                            local arrSize = tonumber(Values["arrow_size"]) or 14
                            local arrCol = (role == "Murderer")
                                and Color3.fromRGB(255, 42, 75)
                                or ((ItemColors["out_of_view_arrow"] and ItemColors["out_of_view_arrow"][2]) or Color3.fromRGB(56, 189, 248))
                            local tri = MathEngine.GetOffScreenArrowTriangle(hrp.Position, 145, arrSize)
                            if tri then
                                SetGuiLine(pack.ArrowEdge1, tri.Tip, tri.Left, 2.0, arrCol)
                                SetGuiLine(pack.ArrowEdge2, tri.Tip, tri.Right, 2.0, arrCol)
                                SetGuiLine(pack.ArrowEdge3, tri.Left, tri.Right, 2.0, arrCol)
                                if pack.DrawingTriangle then
                                    pcall(function()
                                        pack.DrawingTriangle.PointA = tri.Tip
                                        pack.DrawingTriangle.PointB = tri.Left
                                        pack.DrawingTriangle.PointC = tri.Right
                                        pack.DrawingTriangle.Color = arrCol
                                        pack.DrawingTriangle.Visible = true
                                    end)
                                end
                            end
                        else
                            pack.ArrowEdge1.Visible = false
                            pack.ArrowEdge2.Visible = false
                            pack.ArrowEdge3.Visible = false
                            if pack.DrawingTriangle then
                                pcall(function() pack.DrawingTriangle.Visible = false end)
                            end
                        end
                    end
                else
                    Ony.HidePlayerESPPack(pack)
                    if char and char:FindFirstChild("OnyWtfChams") then
                        char.OnyWtfChams:Destroy()
                    end
                end
            end
        end
    end))

    -- // 9.2 Physics & Movement Stepped / Heartbeat Loop (WalkSpeed, JumpPower, Gravity, FOV, TPWalk, Noclip, Fly, BHop, WallHop, AntiVoid, Spinbot, FakeLag, Player Attach/Orbit/Stare)
    TrackConnection(RunService.Stepped:Connect(function(_, dt)
        local char = LocalPlayer.Character
        if not char then
            return
        end
        local hum = char:FindFirstChildOfClass("Humanoid")
        local hrp = char:FindFirstChild("HumanoidRootPart")

        -- 1. WalkSpeed with Clean Restoration
        if hum then
            if Flags["enable_walkspeed"] then
                WalkSpeedModified = true
                hum.WalkSpeed = tonumber(Values["walkspeed_val"]) or 32
            elseif WalkSpeedModified then
                WalkSpeedModified = false
                hum.WalkSpeed = Ony.OriginalDefaults.WalkSpeed
            end

            -- 2. JumpPower with Clean Restoration
            if Flags["enable_jumppower"] then
                JumpPowerModified = true
                hum.UseJumpPower = true
                hum.JumpPower = tonumber(Values["jumppower_val"]) or 85
            elseif JumpPowerModified then
                JumpPowerModified = false
                hum.JumpPower = Ony.OriginalDefaults.JumpPower
            end
        end

        -- 3. Custom Workspace Gravity with Clean Restoration
        if Flags["enable_gravity"] then
            GravityModified = true
            Workspace.Gravity = tonumber(Values["gravity_val"]) or 196
        elseif GravityModified then
            GravityModified = false
            Workspace.Gravity = Ony.OriginalDefaults.Gravity
        end

        -- 4. Custom Camera FOV with Clean Restoration
        if Camera then
            if Flags["enable_fov_cam"] then
                CameraFovModified = true
                Camera.FieldOfView = tonumber(Values["camera_fov_val"]) or 95
            elseif CameraFovModified then
                CameraFovModified = false
                Camera.FieldOfView = Ony.OriginalDefaults.FieldOfView
            end
        end

        -- 5. Noclip Phase Walls (or Active Autofarm) with Clean Restoration
        if Flags["noclip"] or Flags["auto_farm"] then
            NoclipModified = true
            for _, part in ipairs(char:GetDescendants()) do
                if part:IsA("BasePart") and part.CanCollide then
                    part.CanCollide = false
                end
            end
        elseif NoclipModified then
            NoclipModified = false
            for _, part in ipairs(char:GetDescendants()) do
                if part:IsA("BasePart") and (part.Name == "HumanoidRootPart" or part.Name == "Torso" or part.Name == "UpperTorso" or part.Name == "LowerTorso") then
                    part.CanCollide = true
                end
            end
        end

        -- 6. TPWalk (CFrame Speed Translation)
        if Flags["tpwalk"] and hrp and hum and hum.MoveDirection.Magnitude > 0 then
            local tpSpeed = tonumber(Values["tpwalk_speed"]) or 65
            hrp.CFrame = hrp.CFrame + (hum.MoveDirection * (tpSpeed * dt * 0.45))
        end

        -- 7. 6-DOF Flight Controller, Seamless Clone Invisibility & AirWalk Platform
        Ony.UpdateInvisibilityState()
        Ony.UpdateFlightController(dt)
        Ony.UpdateAirWalkPlatform()

        -- 8. Bunny Hop (Auto Jump + Air Strafe Boost)
        if Flags["bunny_hop"] and hum and hrp and hum.MoveDirection.Magnitude > 0 then
            if hum.FloorMaterial ~= Enum.Material.Air then
                hum:ChangeState(Enum.HumanoidStateType.Jumping)
            else
                hrp.CFrame = hrp.CFrame + (hum.MoveDirection * (dt * 12))
            end
        end

        -- 9. Auto Wall Hop (Detects Wall Ahead While Jumping & Flicks)
        if Flags["auto_wall_hop"] and hum and hrp and hum.FloorMaterial == Enum.Material.Air then
            local rayParams = RaycastParams.new()
            rayParams.FilterType = Enum.RaycastFilterType.Exclude
            rayParams.FilterDescendantsInstances = { char }
            local wallHit = Workspace:Raycast(hrp.Position, hrp.CFrame.LookVector * 2.8, rayParams)
            if wallHit then
                hum:ChangeState(Enum.HumanoidStateType.Jumping)
                hrp.AssemblyLinearVelocity = Vector3.new(hrp.AssemblyLinearVelocity.X, 46, hrp.AssemblyLinearVelocity.Z)
            end
        end

        -- 10. Anti-Void Rescue
        if Flags["anti_void"] and hrp then
            if hrp.Position.Y < -65 then
                local map = FindActiveMap()
                local sp = map and map:FindFirstChild("Spawns") and map.Spawns:FindFirstChildWhichIsA("BasePart")
                if sp then
                    hrp.AssemblyLinearVelocity = Vector3.zero
                    hrp.CFrame = sp.CFrame + Vector3.new(0, 5, 0)
                else
                    hrp.AssemblyLinearVelocity = Vector3.zero
                    hrp.CFrame = CFrame.new(0, 120, 0)
                end
                NotifyToast("Anti-Void Rescue", "Saved character from void fall!")
            end
        end

        -- 11. Spinbot (Anti-Aim Horizontal Rotation)
        if Flags["spinbot"] and hrp then
            local sp = tonumber(Values["spin_speed"]) or 30
            hrp.CFrame = hrp.CFrame * CFrame.Angles(0, math.rad(sp), 0)
        end

        -- 12. Fake Lag (Replication Choke Simulation)
        if Flags["fake_lag"] and hrp then
            FakeLagCounter = FakeLagCounter + 1
            local interval = tonumber(Values["lag_interval"]) or 5
            local duration = tonumber(Values["lag_duration"]) or 4
            if (FakeLagCounter % (interval + duration)) < duration then
                hrp.Anchored = true
            else
                hrp.Anchored = false
            end
        elseif hrp and hrp.Anchored and not Flags["fake_lag"] then
            hrp.Anchored = false
        end

        -- 13. Anti-Fling (Zero Other Players' Collision & Angular Velocity)
        if Flags["anti_fling"] then
            for _, other in ipairs(Players:GetPlayers()) do
                if other ~= LocalPlayer and other.Character then
                    for _, p in ipairs(other.Character:GetDescendants()) do
                        if p:IsA("BasePart") then
                            p.CanCollide = false
                            p.AssemblyAngularVelocity = Vector3.zero
                            p.AssemblyLinearVelocity = Vector3.zero
                        end
                    end
                end
            end
        end

        -- 14. Player Target Interactions (Head Sit, Backpack Attach, Orbit, Distract Spin, Stare At Target)
        local anyPlayerLock = Flags["head_sit"]
            or Flags["backpack_attach"]
            or Flags["orbit_player"]
            or Flags["distract_spin"]
            or Flags["stare_at_player"]

        if anyPlayerLock and hrp and hum then
            local targetPlr = Ony.ResolveSelectedTargetPlayer()
            local tChar = targetPlr and targetPlr.Character
            local tHrp = tChar and tChar:FindFirstChild("HumanoidRootPart")
            local tHead = tChar and tChar:FindFirstChild("Head")

            if tHrp then
                if Flags["head_sit"] and tHead then
                    hum.Sit = true
                    hrp.AssemblyLinearVelocity = Vector3.zero
                    hrp.CFrame = tHead.CFrame * CFrame.new(0, 1.85, 0)
                elseif Flags["backpack_attach"] then
                    hrp.AssemblyLinearVelocity = Vector3.zero
                    hrp.CFrame = tHrp.CFrame * CFrame.new(0, 0, 1.65)
                elseif Flags["orbit_player"] then
                    local ox = math.cos(OrbitAngle) * 6.5
                    local oz = math.sin(OrbitAngle) * 6.5
                    local orbitPos = tHrp.Position + Vector3.new(ox, 0.5, oz)
                    hrp.AssemblyLinearVelocity = Vector3.zero
                    hrp.CFrame = CFrame.lookAt(orbitPos, tHrp.Position)
                elseif Flags["distract_spin"] then
                    local jitterA = OrbitAngle * 4.5
                    local jx = math.cos(jitterA) * 4.2
                    local jz = math.sin(jitterA) * 4.2
                    local jPos = tHrp.Position + Vector3.new(jx, math.sin(jitterA * 2) * 2, jz)
                    hrp.AssemblyLinearVelocity = Vector3.zero
                    hrp.CFrame = CFrame.lookAt(jPos, tHrp.Position) * CFrame.Angles(0, SpinAngle, 0)
                elseif Flags["stare_at_player"] then
                    local lookTarget = Vector3.new(tHrp.Position.X, hrp.Position.Y, tHrp.Position.Z)
                    hrp.CFrame = CFrame.lookAt(hrp.Position, lookTarget)
                end
            end
        end
    end))

    -- // 9.3 Periodic Automation Scheduler (Autofarm, Combat, Crates, Survival, ServerHop, X-Ray, Hitboxes)
    local LastCrateOpenTick = 0

    task.spawn(function()
        while Ony.ScreenGui and Ony.ScreenGui.Parent do
            Ony.RefreshMM2Roles()
            Ony.UpdateXRayMapWalls()
            Ony.UpdateHitboxExpander()
            Ony.UpdateInvisibilityState()
            Ony.UpdateInnocentSurvivalSuite()
            Ony.UpdateStreamerModeAndAmbience()
            Ony.CheckCharacterKnifeSounds()
            Ony.UpdateKeybindFlagsHUD()

            -- Auto Grab Dropped Gun
            if Flags["auto_grab_gun"] and Telemetry.GunDropped then
                Ony.GrabDroppedGun(false)
            end

            -- Gun Aimbot (Auto Aim & Shoot Murderer)
            if Flags["gun_aimbot_auto"] and (os.clock() - Ony.LastAutoGunShotClock > 0.55) then
                local visOnly = (Values["auto_shoot_visible_only"] ~= false)
                if Ony.ShootMurdererWithGun(visOnly, false) then
                    Ony.LastAutoGunShotClock = os.clock()
                end
            end

            -- Murderer Knife Kill Aura & Kill All Loop & Auto Throw Knife
            if Flags["kill_aura"] or Flags["auto_kill_all"] then
                Ony.ExecuteKnifeCombat(nil)
            end
            if Flags["auto_throw_knife"] then
                Ony.ExecuteAutoThrowKnife()
            end

            -- Zombie Infection Mode Loop
            if Flags["auto_shoot_zombies"] or Flags["auto_infect_survivors"] then
                Ony.ExecuteZombieInfectionLoop()
            end

            -- Auto Open Selected Mystery Box
            if Flags["auto_open_crate"] then
                local delaySec = tonumber(Values["crate_open_delay"]) or 2
                if os.clock() - LastCrateOpenTick >= delaySec then
                    LastCrateOpenTick = os.clock()
                    Ony.ExecuteButtonAction("open_crate_once_btn", nil)
                end
            end

            -- Auto Fling Selected Player
            if Flags["auto_fling_selected"] then
                local targetPlr = Ony.ResolveSelectedTargetPlayer()
                if targetPlr then
                    Ony.ExecuteVelocityFlingOnTarget(targetPlr, 0.32)
                end
            end

            -- Auto Prestige (Level 100)
            if Flags["auto_prestige"] then
                pcall(function()
                    local prestigeRemote = ReplicatedStorage:FindFirstChild("Prestige", true)
                    if prestigeRemote and prestigeRemote:IsA("RemoteEvent") then
                        prestigeRemote:FireServer()
                    end
                end)
            end

            -- Smart ServerHop V3 Timeout Watchdog
            if Flags["enable_smart_serverhop"] then
                local timeoutSec = tonumber(Values["no_round_timeout"]) or 120
                if os.clock() - Telemetry.LastRoundTimestamp > timeoutSec then
                    Ony.ExecuteSmartServerHop()
                end
            end

            -- CoinContainer Tween Autofarm Step
            Ony.ExecuteAutofarmStep()

            -- Update Live UI Telemetry Labels
            if Ony.FarmStatsLabelLine1 and Ony.FarmStatsLabelLine2 then
                local pct = math.floor((Telemetry.CoinsCollected / math.max(1, Telemetry.BagCapacity)) * 100)
                Ony.FarmStatsLabelLine1.Text = string.format(
                    "Farm Live Stats: %s | Coins: %d / %d (%d%%)",
                    Flags["auto_farm"] and "ACTIVE" or "IDLE",
                    Telemetry.CoinsCollected,
                    Telemetry.BagCapacity,
                    pct
                )
                Ony.FarmStatsLabelLine2.Text = string.format(
                    "Map: %s | Speed: %s s/s",
                    tostring(Telemetry.ActiveMapName),
                    tostring(Values["farm_speed"] or 22)
                )
            end

            if Ony.CandyStatsLabelLine1 and Ony.CandyStatsLabelLine2 then
                local candyCollected = (Ony.CandyAutofarmEngine and Ony.CandyAutofarmEngine.CandyBagCurrent) or Telemetry.CoinsCollected
                local candyMax = tonumber(Values["candy_bag_limit"]) or 50
                local candyActive = Flags["auto_candy_farm"] or Flags["candy_magnet"]
                Ony.CandyStatsLabelLine1.Text = string.format(
                    "Candy & Event Token Stats: %s | Bag: %d / %d",
                    candyActive and "FARMING CANDY" or "READY",
                    candyCollected,
                    candyMax
                )
                Ony.CandyStatsLabelLine2.Text = string.format(
                    "Magnet: %s | Mode: %s | Speed: %s s/s",
                    Flags["candy_magnet"] and "25m Active" or "Standby",
                    tostring(Values["candy_farm_mode"] or "Underground"),
                    tostring(Values["candy_farm_speed"] or 23)
                )
            end

            if Ony.FooterCoinsLabel then
                local curMod = tostring(Ony.ActiveModuleMode or "hub_universal")
                if curMod == "mm2" then
                    Ony.FooterCoinsLabel.Text = string.format(
                        "MM2 | Map: %s | Coins: %d/%d | Role: %s",
                        tostring(Telemetry.ActiveMapName),
                        Telemetry.CoinsCollected,
                        Telemetry.BagCapacity,
                        tostring(Telemetry.CurrentRole)
                    )
                else
                    Ony.FooterCoinsLabel.Text = string.format(
                        "%s MODULE | PlaceId: %d | Universal Ready",
                        string.upper(curMod),
                        tonumber(game.PlaceId) or 0
                    )
                end
            end

            if Ony.FooterUserLabel then
                local shownName = Flags["hide_my_name"] and "Ony.wtf_User" or LocalPlayer.Name
                Ony.FooterUserLabel.Text = shownName .. "  |  29d 3h left"
            end

            task.wait(0.24)
        end
    end)

    -- // 9.4 Input Listeners (Infinite Jump, Click TP, Keybinds & GUI Toggle)
    TrackConnection(UserInputService.JumpRequest:Connect(function()
        if Flags["infinite_jump"] and LocalPlayer.Character then
            local hum = LocalPlayer.Character:FindFirstChildOfClass("Humanoid")
            if hum then
                hum:ChangeState(Enum.HumanoidStateType.Jumping)
            end
        end
    end))

    TrackConnection(LocalPlayer.Idled:Connect(function()
        if Flags["anti_afk"] then
            pcall(function()
                VirtualUser:CaptureController()
                VirtualUser:ClickButton2(Vector2.zero)
            end)
        end
    end))

    local KeyCodeLookup = {
        Q = Enum.KeyCode.Q,
        E = Enum.KeyCode.E,
        T = Enum.KeyCode.T,
        G = Enum.KeyCode.G,
        F = Enum.KeyCode.F,
        V = Enum.KeyCode.V,
        N = Enum.KeyCode.N,
        X = Enum.KeyCode.X,
    }

    TrackConnection(UserInputService.InputBegan:Connect(function(input, gp)
        if gp then
            return
        end

        -- Toggle GUI Visibility (Insert or RightShift) with Smooth Minimize/Open
        if input.KeyCode == Ony.GlobalEnv.OnyWtf.Meta.ToggleKey or input.KeyCode == Enum.KeyCode.RightShift then
            if Ony.MainWindow.Visible then
                Ony.MinimizeMenuSmooth()
            else
                Ony.OpenMenuSmooth()
            end
            return
        end

        -- Click Teleport (Ctrl + Left Click or Click when click_tp is ON)
        if Flags["click_tp"] and input.UserInputType == Enum.UserInputType.MouseButton1 then
            if UserInputService:IsKeyDown(Enum.KeyCode.LeftControl) or UserInputService:IsKeyDown(Enum.KeyCode.RightControl) then
                local mouse = LocalPlayer:GetMouse()
                local hrp = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
                if mouse and mouse.Hit and hrp then
                    hrp.CFrame = CFrame.new(mouse.Hit.Position + Vector3.new(0, 3.2, 0))
                    NotifyToast("Click Teleport", "Teleported to cursor world position!")
                end
            end
        end

        -- Feature Keybind Dispatcher
        if input.KeyCode == Enum.KeyCode.Q and Flags["enable_aimbot"] and tostring(Values["aimbot_mode"]) == "Toggle Key" then
            Ony.AimbotToggleKeyState = not Ony.AimbotToggleKeyState
            NotifyToast("Aimbot Toggle", "Aimbot Lock: " .. (Ony.AimbotToggleKeyState and "ACTIVE" or "PAUSED"))
            return
        end

        for itemId, kbStr in pairs(ItemKeybinds) do
            local mappedKey = KeyCodeLookup[tostring(kbStr)]
            if mappedKey and input.KeyCode == mappedKey then
                if itemId ~= "enable_aimbot" or tostring(Values["aimbot_mode"]) ~= "Hold Key" then
                    local nextState = not Flags[itemId]
                    SetFlagState(itemId, nextState, false)
                    Ony.UpdateKeybindFlagsHUD()
                    NotifyToast("Keybind [" .. tostring(kbStr) .. "]", tostring(itemId) .. ": " .. (nextState and "ENABLED" or "DISABLED"))
                end
            end
        end
    end))

    -- // Clean Teardown Function Registered in GlobalEnv
    Ony.GlobalEnv.OnyWtfCleanup = function()
        Ony.StopActiveFarmTween()
        for _, conn in ipairs(Ony.ActiveConnections) do
            pcall(function()
                conn:Disconnect()
            end)
        end
        for _, drawObj in ipairs(Ony.ActiveDrawingObjects) do
            pcall(function()
                drawObj:Remove()
            end)
        end
        for _, inst in ipairs(Ony.CreatedWorldInstances) do
            pcall(function()
                inst:Destroy()
            end)
        end
        pcall(function()
            if Ony.ScreenGui and Ony.ScreenGui.Parent then
                Ony.ScreenGui:Destroy()
            end
        end)
    end
end)
