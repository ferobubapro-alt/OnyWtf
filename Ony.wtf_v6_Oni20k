-- Canlı RenderStepped Döngüsü (WalkFling, TouchFling, Flight, Noclip, Disco, Rainbow)
RunService.RenderStepped:Connect(function()
    local myChar = LocalPlayer.Character
    local myHrp = myChar and myChar:FindFirstChild("HumanoidRootPart") :: BasePart?
    local myHum = myChar and myChar:FindFirstChildOfClass("Humanoid")

    if State.Flying and myHrp and myHum then
        local cam = Workspace.CurrentCamera
        local moveDir = myHum.MoveDirection
        if moveDir.Magnitude > 0 then
            myHrp.AssemblyLinearVelocity = (cam.CFrame.LookVector * (State.FlySpeed)) + Vector3.new(0, 2, 0)
        else
            myHrp.AssemblyLinearVelocity = Vector3.new(0, 1.5, 0)
        end
    end

    if State.Noclip and myChar then
        for _, part in ipairs(myChar:GetDescendants()) do
            if part:IsA("BasePart") then
                part.CanCollide = false
            end
        end
    end

    if (State.WalkFling or State.TouchFling) and myHrp then
        local pwr = State.WalkFling and State.WalkFlingPower or State.TouchFlingPower
        local origVel = myHrp.AssemblyLinearVelocity
        myHrp.AssemblyLinearVelocity = origVel * pwr + Vector3.new(0, pwr, 0)
        RunService.RenderStepped:Wait()
        if myHrp and myHrp.Parent then
            myHrp.AssemblyLinearVelocity = origVel
        end
    end

    if State.DiscoMode then
        local hue = (tick() * 0.45) % 1
        Lighting.Ambient = Color3.fromHSV(hue, 0.85, 1)
        Lighting.OutdoorAmbient = Color3.fromHSV((hue + 0.3) % 1, 0.85, 1)
    end

    for plrName, active in pairs(State.RainbowPlayers) do
        if active then
            local p = Players:FindFirstChild(plrName) :: Player?
            if p and p.Character then
                local col = Color3.fromHSV((tick() * 0.6) % 1, 0.85, 1)
                for _, part in ipairs(p.Character:GetDescendants()) do
                    if part:IsA("BasePart") and part.Name ~= "HumanoidRootPart" then
                        part.Color = col
                    end
                end
            end
        end
    end
end)

