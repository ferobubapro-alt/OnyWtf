function MathEngine.GetCharacterBoneSegments(character)
    if not character then
        return {}
    end
    local isR15 = (character:FindFirstChild("UpperTorso") ~= nil)
    local pairsList = isR15 and MathEngine.R15BonePairs or MathEngine.R6BonePairs
    local segments = {}

    for _, pair in ipairs(pairsList) do
        local pA = character:FindFirstChild(pair[1])
        local pB = character:FindFirstChild(pair[2])
        if pA and pB and pA:IsA("BasePart") and pB:IsA("BasePart") then
            local sA, onA = MathEngine.WorldToScreen(pA.Position)
            local sB, onB = MathEngine.WorldToScreen(pB.Position)
            if onA and onB then
                table.insert(segments, { A = sA, B = sB })
            end
        end
    end
    return segments
end

function MathEngine.GetOffScreenArrowTriangle(worldPos, radiusFromCenter, arrowSize)
    if not Camera then
        return nil
    end
    local vp = Camera.ViewportSize
    local center = vp * 0.5
    local rel = Camera.CFrame:PointToObjectSpace(worldPos)
    local angle = math.atan2(-rel.Y, rel.X)

    local tipDist = radiusFromCenter + arrowSize * 0.6
    local baseDist = radiusFromCenter - arrowSize * 0.5

    local dir = Vector2.new(math.cos(angle), math.sin(angle))
    local perp = Vector2.new(-dir.Y, dir.X)

    local tip = center + dir * tipDist
    local baseCenter = center + dir * baseDist
    local leftWing = baseCenter + perp * (arrowSize * 0.55)
    local rightWing = baseCenter - perp * (arrowSize * 0.55)

    return {
        Tip = tip,
        Left = leftWing,
        Right = rightWing,
        Center = center + dir * radiusFromCenter,
        AngleDeg = math.deg(angle),
    }
end

function MathEngine.ComputeKnifeThrowArc(originPos, lookDir, speed, gravity, stepCount)
    local points = {}
    local dt = 0.045
    local gVec = Vector3.new(0, -math.abs(gravity or 95), 0)
    local vel = lookDir.Unit * (speed or 115)
    local currPos = originPos

    local rayParams = RaycastParams.new()
    rayParams.FilterType = Enum.RaycastFilterType.Exclude
    rayParams.IgnoreWater = true
    if LocalPlayer and LocalPlayer.Character then
        rayParams.FilterDescendantsInstances = { LocalPlayer.Character }
    end

    table.insert(points, currPos)
    local hitPosition = nil

    for _ = 1, (stepCount or 16) do
        local nextVel = vel + gVec * dt
        local nextPos = currPos + ((vel + nextVel) * 0.5) * dt
        local segDelta = nextPos - currPos
        local rayResult = Workspace:Raycast(currPos, segDelta, rayParams)
        if rayResult then
            table.insert(points, rayResult.Position)
            hitPosition = rayResult.Position
            break
        end
        table.insert(points, nextPos)
        currPos = nextPos
        vel = nextVel
    end

    return points, hitPosition or currPos
end

function MathEngine.IsPartVisible(targetPart, ignoreList)
    if not Camera or not targetPart then
        return false
    end
    local origin = Camera.CFrame.Position
    local direction = targetPart.Position - origin
    if direction.Magnitude < 1 then
        return true
    end

    local params = RaycastParams.new()
    params.FilterType = Enum.RaycastFilterType.Exclude
    params.IgnoreWater = true

    local filter = { Camera }
    if LocalPlayer and LocalPlayer.Character then
        table.insert(filter, LocalPlayer.Character)
    end
    if type(ignoreList) == "table" then
        for _, item in ipairs(ignoreList) do
            table.insert(filter, item)
        end
    end
    params.FilterDescendantsInstances = filter

    local result = Workspace:Raycast(origin, direction, params)
    if not result then
        return true
    end
    if targetPart.Parent and result.Instance:IsDescendantOf(targetPart.Parent) then
        return true
    end
    return false
end

function MathEngine.ResolveHitboxPart(character, preference)
    if not character then
        return nil
    end
    local pref = tostring(preference or "Head")
    if pref == "Head" then
        return character:FindFirstChild("Head") or character:FindFirstChild("HumanoidRootPart")
    elseif pref == "HumanoidRootPart" then
        return character:FindFirstChild("HumanoidRootPart") or character:FindFirstChild("Head")
    elseif pref == "Torso" then
        return character:FindFirstChild("UpperTorso")
            or character:FindFirstChild("Torso")
            or character:FindFirstChild("HumanoidRootPart")
    elseif pref == "Legs" then
        return character:FindFirstChild("RightUpperLeg")
            or character:FindFirstChild("Right Leg")
            or character:FindFirstChild("LowerTorso")
            or character:FindFirstChild("HumanoidRootPart")
    elseif pref == "Arms" then
        return character:FindFirstChild("RightUpperArm")
            or character:FindFirstChild("Right Arm")
            or character:FindFirstChild("HumanoidRootPart")
    end
    return character:FindFirstChild("HumanoidRootPart") or character:FindFirstChild("Head")
end

function MathEngine.PredictTargetPosition(targetPart, shotMode, yOffset)
    if not targetPart then
        return Vector3.zero
    end
    local basePos = targetPart.Position
    local vel = targetPart.AssemblyLinearVelocity or Vector3.zero
    local mode = tostring(shotMode or "Ping Prediction")
    local yOff = tonumber(yOffset) or 0

    if mode == "Default" then
        return basePos + Vector3.new(0, yOff, 0)
    elseif mode == "Teleport Bullet" then
        local lead = vel * 0.045
        return basePos + lead + Vector3.new(0, yOff, 0)
    else
        local ping = MathEngine.GetPingSeconds()
        local leadFactor = MathEngine.Clamp(ping * 1.65 + 0.085, 0.10, 0.36)
        return basePos + (vel * leadFactor) + Vector3.new(0, yOff, 0)
    end
end



