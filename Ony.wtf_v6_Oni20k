            local cContainer = child:FindFirstChild("CoinContainer")
            if cContainer then
                for _, token in ipairs(cContainer:GetChildren()) do
                    local part = token:IsA("BasePart") and token or token:FindFirstChildWhichIsA("BasePart")
                    if part and part.Transparency < 0.98 then
                        local lName = string.lower(token.Name)
                        if string.find(lName, "candy") or string.find(lName, "snow") or string.find(lName, "egg") or string.find(lName, "beach") or token:FindFirstChild("Candy") then
                            table.insert(self.SpatialCandies, part)
                        else
                            table.insert(self.SpatialCoins, part)
                        end
                    end
                end
            end
        end
