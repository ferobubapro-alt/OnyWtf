            TrackConnection(Ony.RoundStartRemote.OnClientEvent:Connect(function()
                Ony.CurrentRoundId = Ony.CurrentRoundId + 1
                Telemetry.RoundsPlayed = Telemetry.RoundsPlayed + 1
                Telemetry.CoinsCollected = 0
                Telemetry.LastRoundTimestamp = os.clock()
                task.delay(1.2, Ony.RefreshMM2Roles)
            end))
        end
    end)

    function Ony.GetMurdererPlayer()
        for _, plr in ipairs(Players:GetPlayers()) do
            if plr ~= LocalPlayer and Ony.ResolvePlayerRole(plr) == "Murderer" and Ony.IsPlayerInActiveRound(plr) then
                return plr
            end
        end
        return nil
    end
