local Ony = {}

-- Isolated Section Runner: Gives each section its own Luau function Proto (fresh 200-register
-- stack & constant table) and logs any runtime error without halting subsequent sections.
function Ony.RunSection(sectionName, sectionFn)
    local ok, err = xpcall(sectionFn, function(e)
        if type(debug) == "table" and type(debug.traceback) == "function" then
            return tostring(e) .. "\n" .. tostring(debug.traceback("", 2))
        end
        return tostring(e)
    end)
    if ok then
        print("[Ony.wtf v6.1.0-ONI] Loaded Section: " .. tostring(sectionName))
    else
        SafeWarn("[Ony.wtf v6.1.0-ONI] Section Error [" .. tostring(sectionName) .. "]: " .. tostring(err))
    end
    return ok
end

