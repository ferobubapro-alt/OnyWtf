            if res and res.Body then
                local ok, data = pcall(function()
                    return HttpService:JSONDecode(res.Body)
                end)
                if ok and type(data) == "table" and type(data.data) == "table" then
                    local avoidVisited = (Flags["avoid_visited_jobids"] == true)
                    for _, srv in ipairs(data.data) do
                        local idStr = tostring(srv.id or "")
                        local playing = tonumber(srv.playing) or 0
                        local maxPlrs = tonumber(srv.maxPlayers) or 12
                        if idStr ~= "" and idStr ~= tostring(game.JobId) and playing >= 4 and playing < maxPlrs then
                            if (not avoidVisited) or (not VisitedServerJobIds[idStr]) then
                                VisitedServerJobIds[idStr] = true
                                pcall(function()
                                    if ExecutorCaps.HasFileSystem then
                                        if not isfolder(CONFIG_FOLDER) then makefolder(CONFIG_FOLDER) end
                                        writefile(VISITED_JOBS_FILE, HttpService:JSONEncode(VisitedServerJobIds))
                                    end
                                end)
                                NotifyToast("Smart ServerHop V3", "Teleporting to server (" .. tostring(playing) .. "/" .. tostring(maxPlrs) .. ")...")
                                pcall(function()
                                    TeleportService:TeleportToPlaceInstance(game.PlaceId, idStr, LocalPlayer)
                                end)
                                return
                            end
                        end
                    end
                end
            end
            pcall(function()
                TeleportService:Teleport(game.PlaceId, LocalPlayer)
            end)
        end)
    end
    Ony.ExecuteSmartServerHop = ExecuteSmartServerHop

