    Ony.CandyFarmEngine = CandyFarmEngine

    function CandyFarmEngine:FindBestCandyOrEventToken(originPos, evadeMurderer, evadeRadius)
        PerfOptimizer:RefreshSpatialCacheNow()
        local candidates = #PerfOptimizer.SpatialCandies > 0 and PerfOptimizer.SpatialCandies or PerfOptimizer.SpatialCoins
        local murderPos = nil
        if evadeMurderer and Ony.FindMurdererPlayer then
            local murd = Ony.FindMurdererPlayer()
            if murd and murd.Character and murd.Character:FindFirstChild("HumanoidRootPart") then
                murderPos = murd.Character.HumanoidRootPart.Position
            end
        end
        local bestPart = nil
        local bestScore = math.huge
        for _, part in ipairs(candidates) do
            if part and part.Parent and part.Transparency < 0.95 then
                local dist = (part.Position - originPos).Magnitude
                local safe = true
                if murderPos then
                    local mDist = (part.Position - murderPos).Magnitude
                    if mDist < (evadeRadius or 32) then
                        safe = false
                    end
                end
                if safe and dist < bestScore then
                    bestScore = dist
                    bestPart = part
                end
            end
        end
        return bestPart, bestScore
    end

    function CandyFarmEngine:StepCandyFarm(cfg)
        if not cfg or not cfg.Enabled then return end
        local char = LocalPlayer and LocalPlayer.Character
        local hrp = char and char:FindFirstChild("HumanoidRootPart")
        local hum = char and char:FindFirstChildOfClass("Humanoid")
        if not hrp or not hum or hum.Health <= 0 then return end

        -- 1. TouchInterest Magnet for nearby Candy / SnowTokens
        if cfg.Enabled["candy_magnet"] and type(firetouchinterest) == "function" then
            PerfOptimizer:RefreshSpatialCacheNow()
            local pool = #PerfOptimizer.SpatialCandies > 0 and PerfOptimizer.SpatialCandies or PerfOptimizer.SpatialCoins
            for _, tokenPart in ipairs(pool) do
                if tokenPart and tokenPart.Parent and (tokenPart.Position - hrp.Position).Magnitude <= 26 then
                    pcall(function()
                        firetouchinterest(hrp, tokenPart, 0)
                        firetouchinterest(hrp, tokenPart, 1)
                    end)
                end
            end
        end

        -- 1b. Event Candy & Seasonal Token 3D ESP (candy_esp) & Auto Exchange Candy (auto_exchange_candy)
        if cfg.Enabled["candy_esp"] then
            PerfOptimizer:RefreshSpatialCacheNow()
            for _, candyPart in ipairs(PerfOptimizer.SpatialCandies) do
                if candyPart and candyPart.Parent and not candyPart:FindFirstChild("OnyCandyHighlight") then
                    pcall(function()
                        local hl = Instance.new("Highlight")
                        hl.Name = "OnyCandyHighlight"
                        hl.FillColor = Color3.fromRGB(255, 110, 199)
                        hl.OutlineColor = Color3.fromRGB(0, 245, 212)
                        hl.FillTransparency = 0.35
                        hl.Parent = candyPart
                    end)
                end
            end
        end
        if cfg.Enabled["auto_exchange_candy"] and self.CandyCollectedSession >= 100 then
            pcall(function()
                if Ony.BoxControllerRemote then
                    Ony.BoxControllerRemote:Fire("EventBox")
                end
            end)
        end

        -- 2. Full Candy & Event Token Autofarm
        if not cfg.Enabled["auto_candy_farm"] then return end
        local bagLimit = tonumber(cfg.SubValues["candy_bag_limit"]) or 50
        if self.CurrentRoundCandy >= bagLimit then
            if cfg.Enabled["candy_end_round_action"] then
                hrp.CFrame = CFrame.new(0, 145, 0)
            end
            return
        end

        local evade = cfg.Enabled["candy_avoid_murderer"]
        local evadeRad = tonumber(cfg.SubValues["candy_evade_radius"]) or 32
        local targetToken, dist = self:FindBestCandyOrEventToken(hrp.Position, evade, evadeRad)
        if not targetToken then return end

        local speed = math.clamp(tonumber(cfg.SubValues["candy_farm_speed"]) or 23, 10, 40)
        local mode = tostring(cfg.SubValues["candy_farm_mode"] or "Underground Lie-Down Bypass")
        local yOffset = string.find(mode, "Underground") and -3.2 or 0.5
        local goalPos = targetToken.Position + Vector3.new(0, yOffset, 0)
        local goalCF = CFrame.new(goalPos) * (string.find(mode, "Underground") and CFrame.Angles(math.rad(90), 0, 0) or CFrame.identity)

        for _, part in ipairs(char:GetDescendants()) do
            if part:IsA("BasePart") then part.CanCollide = false end
        end

        local stepAlpha = math.clamp((speed * 0.03) / math.max(dist, 0.01), 0.05, 1)
        hrp.Velocity = Vector3.zero
        hrp.CFrame = hrp.CFrame:Lerp(goalCF, stepAlpha)
        if dist <= 5.5 then
            if type(firetouchinterest) == "function" then
                pcall(function()
                    firetouchinterest(hrp, targetToken, 0)
                    firetouchinterest(hrp, targetToken, 1)
                end)
            end
            self.CandyCollectedSession = self.CandyCollectedSession + 1
            self.CurrentRoundCandy = self.CurrentRoundCandy + 1
            if Ony.Telemetry then
                Ony.Telemetry.CandiesCollected = self.CandyCollectedSession
            end
        end
    end

