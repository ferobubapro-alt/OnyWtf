local function SetPlayerRankInTable(targetName: string, newLevel: number)
    if string.lower(targetName) == "b1rkt" and newLevel < 10 then return end
    TableDB.RanksByUsername[targetName] = newLevel
    SyncTablePersistence()
    PlayUiSound("rank")
    BroadcastAnimateBridgePacket("SETRANK", targetName, tostring(newLevel))
    local targetPlr = Players:FindFirstChild(targetName) :: Player?
    if targetPlr then
        UpdatePlayerOverheadP2PBadge(targetPlr)
    end
    if targetName == LocalPlayer.Name then
        State.LocalRankLevel = newLevel
        if RefreshTopBarRankDisplay then RefreshTopBarRankDisplay() end
    end
end

local function CreateCustomPermissionTierInTable(level: number, code: string, displayName: string, coreGroup: string)
    if State.LocalRankLevel < 10 then return end
    local newTier: TierDefinition = {
        Level = level,
        Id = string.upper(code),
        Name = displayName,
        TurkishName = displayName,
        CoreGroup = coreGroup,
        BadgeText = string.format("TIER %d · %s", level, string.upper(code)),
        Color = Color3.fromRGB(56, 189, 248),
        CanModifyRanks = (coreGroup ~= "User"),
        CanCreateCustomTiers = (coreGroup == "Owner"),
        MaxTargetRank = level - 1,
        IsCustom = true
    }
    DEFAULT_TIERS[level] = newTier
    TableDB.CustomTiers[level] = newTier
    SyncTablePersistence()
    PlayUiSound("rank")
end

