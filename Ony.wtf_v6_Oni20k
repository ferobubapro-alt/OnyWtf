local CommandRegistry: { [string]: any } = {}
for _, cmd in ipairs(CommandList) do
    CommandRegistry[string.lower(cmd.Name)] = cmd
end

for cmdName, overrideTier in pairs(TableDB.CommandMinTierOverrides) do
    if CommandRegistry[cmdName] then
        CommandRegistry[cmdName].MinTier = overrideTier
    end
end

local function CanPlayerExecuteCommand(playerRank: number, cmdName: string): (boolean, string)
    local cmd = CommandRegistry[string.lower(cmdName)]
    if not cmd then
        return false, "Komut bulunamadı."
    end
    if playerRank < cmd.MinTier then
        local reqTier = GetTierData(cmd.MinTier)
        return false, string.format(
            "KİLİTLİ! '%s' için %s (Tier %d) yetkisi gerekiyor.",
            cmd.Name, reqTier.Name, cmd.MinTier
        )
    end
    return true, "Yetki onaylandı."
end

