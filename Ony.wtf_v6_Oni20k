local function SafeHttpRequest(options)
    local reqFunc = (type(request) == "function" and request)
        or (type(http_request) == "function" and http_request)
        or (type(syn) == "table" and type(syn.request) == "function" and syn.request)
        or (type(http) == "table" and type(http.request) == "function" and http.request)
    if reqFunc then
        local ok, res = pcall(reqFunc, options)
        if ok then
            return res
        end
    end
    if options and options.Method == "GET" and options.Url then
        local ok, body = pcall(function()
            return game:HttpGet(options.Url)
        end)
        if ok and body then
            return { Body = body, StatusCode = 200 }
        end
    end
    return nil
end
Ony.SafeHttpRequest = SafeHttpRequest

-- // LocalScript & Executor Safe ScreenGui Parenting
-- Supports PlayerGui, gethui(), and CoreGui with automatic verification and console diagnostics
local GUI_NAME = "OnyWtf_MM2_Suite"
Ony.GUI_NAME = GUI_NAME

local function ParentGuiSafely(guiInstance)
    local parented = false
    local mountedLocation = "None"

    -- 1. Try gethui() if available on executor
    if type(gethui) == "function" then
        parented = pcall(function()
            local target = gethui()
            if not target then
                error("gethui returned nil")
            end
            if target:FindFirstChild(GUI_NAME) then
                target[GUI_NAME]:Destroy()
            end
            guiInstance.Parent = target
            if guiInstance.Parent ~= target then
                error("gethui parent assignment failed")
            end
            mountedLocation = "gethui()"
        end)
    end

    -- 2. Try CoreGui next if gethui() didn't mount
    if not parented then
        parented = pcall(function()
            local coreGui = game:GetService("CoreGui")
            if coreGui:FindFirstChild(GUI_NAME) then
                coreGui[GUI_NAME]:Destroy()
            end
            guiInstance.Parent = coreGui
            if guiInstance.Parent ~= coreGui then
                error("CoreGui parent assignment failed")
            end
            mountedLocation = "CoreGui"
        end)
    end

    -- 3. Fallback to LocalPlayer.PlayerGui (100% compatible with Roblox LocalScripts & all Executors)
    if not parented and LocalPlayer then
        parented = pcall(function()
            local playerGui = LocalPlayer:FindFirstChildOfClass("PlayerGui")
                or LocalPlayer:WaitForChild("PlayerGui", 5)
            if not playerGui then
                error("PlayerGui not ready")
            end
            if playerGui:FindFirstChild(GUI_NAME) then
                playerGui[GUI_NAME]:Destroy()
            end
            guiInstance.Parent = playerGui
            if guiInstance.Parent ~= playerGui then
                error("PlayerGui parent assignment failed")
            end
            mountedLocation = "LocalPlayer.PlayerGui"
        end)
    end

    print("[Ony.wtf v6.1.0-ONI] ScreenGui mounted to: " .. tostring(mountedLocation))
end
Ony.ParentGuiSafely = ParentGuiSafely

