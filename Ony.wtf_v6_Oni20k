    -- // 7.1 Elevated Safezone Sky Platform & Air Walk Platform
    local SafezonePlatformPart = nil
    local AirWalkPlatformPart = nil
    local CurrentAirWalkY = nil

    local function GetOrCreateSafezonePlatform()
        if SafezonePlatformPart and SafezonePlatformPart.Parent == Workspace then
            return SafezonePlatformPart
        end
        local part = Instance.new("Part")
        part.Name = "OnySafezoneSkyPlatform"
        part.Size = Vector3.new(85, 2, 85)
        part.Anchored = true
        part.CanCollide = true
        part.Material = Enum.Material.ForceField
        part.Color = Ony.AccentColor
        part.Transparency = 0.45
        part.Position = Vector3.new(0, 260, 0)
        part.Parent = Workspace
        Ony.TrackWorldInstance(part)
        SafezonePlatformPart = part
        return part
    end

    local function TeleportToSafezonePlatform()
        local char = LocalPlayer.Character
        local hrp = char and char:FindFirstChild("HumanoidRootPart")
        if not hrp then
            return
        end
        local map = FindActiveMap()
        local basePos = hrp.Position
        if map and map:FindFirstChild("Spawns") then
            local sp = map.Spawns:FindFirstChildWhichIsA("BasePart")
            if sp then
                basePos = sp.Position
            end
        end
        local plat = GetOrCreateSafezonePlatform()
        plat.Position = Vector3.new(basePos.X, basePos.Y + 135, basePos.Z)
        hrp.AssemblyLinearVelocity = Vector3.zero
        hrp.CFrame = CFrame.new(plat.Position + Vector3.new(0, 4.5, 0))
    end
    Ony.TeleportToSafezonePlatform = TeleportToSafezonePlatform

    local function UpdateAirWalkPlatform()
        local char = LocalPlayer.Character
        local hrp = char and char:FindFirstChild("HumanoidRootPart")
        local hum = char and char:FindFirstChildOfClass("Humanoid")

        if Flags["air_walk"] and hrp and hum then
            if not AirWalkPlatformPart or not AirWalkPlatformPart.Parent then
                AirWalkPlatformPart = Instance.new("Part")
                AirWalkPlatformPart.Name = "OnyAirWalkPad"
                AirWalkPlatformPart.Size = Vector3.new(9, 0.6, 9)
                AirWalkPlatformPart.Anchored = true
                AirWalkPlatformPart.CanCollide = true
                AirWalkPlatformPart.Material = Enum.Material.Neon
                AirWalkPlatformPart.Color = Ony.AccentColor
                AirWalkPlatformPart.Transparency = 0.65
                AirWalkPlatformPart.Parent = Workspace
                Ony.TrackWorldInstance(AirWalkPlatformPart)
            end
            if CurrentAirWalkY == nil then
                CurrentAirWalkY = hrp.Position.Y - 3.3
            end
            if UserInputService:IsKeyDown(Enum.KeyCode.Space) then
                CurrentAirWalkY = CurrentAirWalkY + 0.35
            elseif UserInputService:IsKeyDown(Enum.KeyCode.LeftControl) or UserInputService:IsKeyDown(Enum.KeyCode.LeftShift) then
                CurrentAirWalkY = CurrentAirWalkY - 0.35
            end
            AirWalkPlatformPart.Position = Vector3.new(hrp.Position.X, CurrentAirWalkY, hrp.Position.Z)
        else
            CurrentAirWalkY = nil
            if AirWalkPlatformPart then
                pcall(function()
                    AirWalkPlatformPart:Destroy()
                end)
                AirWalkPlatformPart = nil
            end
        end
    end
    Ony.UpdateAirWalkPlatform = UpdateAirWalkPlatform

    -- // 7.2 Dropped Gun Auto / Manual Grabber
    local IsGrabbingGunLock = false

    local function GrabDroppedGun(notifyUser)
        if IsGrabbingGunLock then
            return
        end
        local gunDrop = Workspace:FindFirstChild("GunDrop", true)
        if not gunDrop or not gunDrop:IsA("BasePart") then
            if notifyUser then
                NotifyToast("Ony.wtf Gun Grab", "No GunDrop currently on the map!")
            end
            return
        end
        local char = LocalPlayer.Character
        local hrp = char and char:FindFirstChild("HumanoidRootPart")
        if not hrp then
            return
        end

        IsGrabbingGunLock = true
        local savedCf = hrp.CFrame

        pcall(function()
            if ExecutorCaps.HasFireTouchInterest then
                firetouchinterest(hrp, gunDrop, 0)
                firetouchinterest(hrp, gunDrop, 1)
            end
            hrp.CFrame = gunDrop.CFrame + Vector3.new(0, 1.5, 0)
            task.wait(0.11)
            if hrp and hrp.Parent then
                hrp.CFrame = savedCf
            end
        end)

        if notifyUser then
            NotifyToast("Ony.wtf Gun Grab", "Claimed Dropped Gun & restored original position!", Color3.fromRGB(255, 213, 42))
        end
        task.delay(0.35, function()
            IsGrabbingGunLock = false
        end)
    end
    Ony.GrabDroppedGun = GrabDroppedGun

    -- // 7.3 Innocent Survival Suite (Survive Safezone, Avoid Murderer Kite, Fake Dead Ragdoll)
    local FakeDeadActiveState = false

    local function UpdateInnocentSurvivalSuite()
        local char = LocalPlayer.Character
        local hrp = char and char:FindFirstChild("HumanoidRootPart")
        local hum = char and char:FindFirstChildOfClass("Humanoid")
        if not char or not hrp or not hum then
            return
        end

        -- Survive on Safezone
        if Flags["survive_safezone"] then
            local plat = GetOrCreateSafezonePlatform()
            if (hrp.Position - plat.Position).Magnitude > 42 then
                TeleportToSafezonePlatform()
            end
        end

        -- Avoid Murderer (Auto Kite Vector Escape)
        if Flags["avoid_murderer"] then
            local murderer = GetMurdererPlayer()
            local mHrp = murderer and murderer.Character and murderer.Character:FindFirstChild("HumanoidRootPart")
            if mHrp then
                local safeDist = tonumber(Values["avoid_distance"]) or 35
                local delta = hrp.Position - mHrp.Position
                local currDist = delta.Magnitude
                if currDist < safeDist and currDist > 0.1 then
                    local escapeDir = Vector3.new(delta.X, 0, delta.Z).Unit
                    local targetEscapePos = hrp.Position + escapeDir * (safeDist - currDist + 14)
                    hrp.CFrame = CFrame.new(targetEscapePos, targetEscapePos + escapeDir)
                end
            end
        end

        -- Fake Dead (Lay Prone / Ragdoll Pose)
        if Flags["fake_dead"] then
            FakeDeadActiveState = true
            hum.PlatformStand = true
            hrp.CFrame = CFrame.new(hrp.Position) * CFrame.Angles(math.rad(90), 0, 0)
        elseif FakeDeadActiveState then
            FakeDeadActiveState = false
            hum.PlatformStand = false
            hrp.CFrame = CFrame.new(hrp.Position + Vector3.new(0, 2.5, 0))
        end
    end
    Ony.UpdateInnocentSurvivalSuite = UpdateInnocentSurvivalSuite

    -- // 7.4 CoinContainer Tween Autofarm & Bag Full Handlers
    local ActiveFarmTween = nil
    local BagFullHandledThisRound = false

    local function StopActiveFarmTween()
        if ActiveFarmTween then
            pcall(function()
                ActiveFarmTween:Cancel()
            end)
            ActiveFarmTween = nil
        end
    end
    Ony.StopActiveFarmTween = StopActiveFarmTween

    local function ExecuteAutofarmStep()
        if not Flags["auto_farm"] then
            StopActiveFarmTween()
            return
        end

        local char = LocalPlayer.Character
        local hrp = char and char:FindFirstChild("HumanoidRootPart")
        local hum = char and char:FindFirstChildOfClass("Humanoid")
        if not char or not hrp or not hum or hum.Health <= 0 then
            return
        end

        -- Check if Coin Bag is Full (40 or 50)
        if Telemetry.CoinsCollected >= Telemetry.BagCapacity then
            StopActiveFarmTween()
            if not BagFullHandledThisRound then
                BagFullHandledThisRound = true
                NotifyToast("Coin Bag Full!", string.format("Collected %d/%d coins!", Telemetry.CoinsCollected, Telemetry.BagCapacity), Color3.fromRGB(42, 255, 101))

                if Flags["webhook_bag_full"] and Ony.SendWebhookEvent then
                    Ony.SendWebhookEvent("MM2 Coin Bag Full", string.format("Bag reached **%d/%d** coins in map **%s**.", Telemetry.CoinsCollected, Telemetry.BagCapacity, tostring(Telemetry.ActiveMapName)))
                end

                if Flags["auto_reset_bag_full"] then
                    hum.Health = 0
                elseif Flags["auto_safezone_bag_full"] then
                    TeleportToSafezonePlatform()
                elseif Flags["auto_win_bag_full"] then
                    local myRole = ResolvePlayerRole(LocalPlayer)
                    if myRole == "Sheriff" or myRole == "Hero" then
                        ShootMurdererWithGun(false, true)
                    elseif myRole == "Murderer" then
                        ExecuteKnifeCombat(nil)
                    else
                        TeleportToSafezonePlatform()
                    end
                end
            end
            return
        else
            BagFullHandledThisRound = false
        end

        -- Auto Claim Battlepass / Event Rewards if toggled
        if Flags["auto_claim_rewards"] then
            pcall(function()
                local claimRemote = ReplicatedStorage:FindFirstChild("ClaimReward", true)
                    or ReplicatedStorage:FindFirstChild("ClaimPassReward", true)
                if claimRemote and claimRemote:IsA("RemoteEvent") then
                    claimRemote:FireServer()
                end
            end)
        end

        local bestCoin, dist = FindBestCoinTarget()
        if not bestCoin then
            return
        end

        local farmSpeed = MathEngine.Clamp(tonumber(Values["farm_speed"]) or 22, 10, 45)
        local duration = MathEngine.Clamp(dist / farmSpeed, 0.12, 4.5)

        local targetCf
        if Flags["underground_farm"] then
            hum.PlatformStand = true
            targetCf = CFrame.new(bestCoin.Position - Vector3.new(0, 3.2, 0)) * CFrame.Angles(math.rad(90), 0, 0)
        else
            if not Flags["fake_dead"] then
                hum.PlatformStand = false
            end
            targetCf = CFrame.new(bestCoin.Position)
        end

        hrp.AssemblyLinearVelocity = Vector3.zero
        hrp.AssemblyAngularVelocity = Vector3.zero

        StopActiveFarmTween()
        ActiveFarmTween = TweenService:Create(
            hrp,
            TweenInfo.new(duration, Enum.EasingStyle.Linear, Enum.EasingDirection.Out),
            { CFrame = targetCf }
        )
        ActiveFarmTween:Play()

        if dist <= 9.5 then
            if ExecutorCaps.HasFireTouchInterest then
                pcall(function()
                    firetouchinterest(hrp, bestCoin, 0)
                    firetouchinterest(hrp, bestCoin, 1)
                end)
            end
            Telemetry.CoinsCollected = math.min(Telemetry.BagCapacity, Telemetry.CoinsCollected + 1)
        end
    end
    Ony.ExecuteAutofarmStep = ExecuteAutofarmStep

    -- // 7.5 Classic 3D Omnidirectional 6-DOF Flight Engine (Full Pitch/Vertical + BodyMover & CFrame Hybrid)
    local FlyBodyVelocity = nil
    local FlyBodyGyro = nil
    local FlyPlatformStandActive = false

    local function UpdateFlightController(dt)
        local stepDt = tonumber(dt) or 0.016
        local char = LocalPlayer.Character
        local hrp = char and char:FindFirstChild("HumanoidRootPart")
        local hum = char and char:FindFirstChildOfClass("Humanoid")

        if Flags["fly_mode"] and hrp and hum and Camera then
            FlyPlatformStandActive = true
            hum.PlatformStand = true

            if not FlyBodyVelocity or FlyBodyVelocity.Parent ~= hrp then
                if FlyBodyVelocity then pcall(function() FlyBodyVelocity:Destroy() end) end
                FlyBodyVelocity = Instance.new("BodyVelocity")
                FlyBodyVelocity.Name = "OnyFlyVelocity"
                FlyBodyVelocity.MaxForce = Vector3.new(9e8, 9e8, 9e8)
                FlyBodyVelocity.P = 12500
                FlyBodyVelocity.Velocity = Vector3.zero
                FlyBodyVelocity.Parent = hrp
            end
            if not FlyBodyGyro or FlyBodyGyro.Parent ~= hrp then
                if FlyBodyGyro then pcall(function() FlyBodyGyro:Destroy() end) end
                FlyBodyGyro = Instance.new("BodyGyro")
                FlyBodyGyro.Name = "OnyFlyGyro"
                FlyBodyGyro.MaxTorque = Vector3.new(9e8, 9e8, 9e8)
                FlyBodyGyro.P = 12500
                FlyBodyGyro.D = 450
                FlyBodyGyro.CFrame = Camera.CFrame
                FlyBodyGyro.Parent = hrp
            end

            local flySpeed = tonumber(Values["fly_speed"]) or 50
            local moveDir = Vector3.zero
            local camCf = Camera.CFrame
            local lookVec = camCf.LookVector
            local rightVec = camCf.RightVector

            -- Classic 3D Camera-Directional WASD (includes vertical pitch up/down when looking up/down)
            if not UserInputService:GetFocusedTextBox() then
                if UserInputService:IsKeyDown(Enum.KeyCode.W) or UserInputService:IsKeyDown(Enum.KeyCode.Up) then
                    moveDir = moveDir + lookVec
                end
                if UserInputService:IsKeyDown(Enum.KeyCode.S) or UserInputService:IsKeyDown(Enum.KeyCode.Down) then
                    moveDir = moveDir - lookVec
                end
                if UserInputService:IsKeyDown(Enum.KeyCode.D) or UserInputService:IsKeyDown(Enum.KeyCode.Right) then
                    moveDir = moveDir + rightVec
                end
                if UserInputService:IsKeyDown(Enum.KeyCode.A) or UserInputService:IsKeyDown(Enum.KeyCode.Left) then
                    moveDir = moveDir - rightVec
                end
                -- Dedicated Vertical Ascent / Descent Keys (Space/E = Up, LeftShift/LeftControl/C = Down)
                if UserInputService:IsKeyDown(Enum.KeyCode.Space) or UserInputService:IsKeyDown(Enum.KeyCode.E) then
                    moveDir = moveDir + Vector3.new(0, 1, 0)
                end
                if UserInputService:IsKeyDown(Enum.KeyCode.LeftShift) or UserInputService:IsKeyDown(Enum.KeyCode.LeftControl) or UserInputService:IsKeyDown(Enum.KeyCode.C) then
                    moveDir = moveDir - Vector3.new(0, 1, 0)
                end
            end

            -- Mobile / Gamepad Thumbstick 3D Camera Projection Fallback
            if moveDir.Magnitude == 0 and hum.MoveDirection.Magnitude > 0 then
                local flatLook = Vector3.new(lookVec.X, 0, lookVec.Z)
                local flatRight = Vector3.new(rightVec.X, 0, rightVec.Z)
                if flatLook.Magnitude > 0.01 and flatRight.Magnitude > 0.01 then
                    local fUnit = flatLook.Unit
                    local rUnit = flatRight.Unit
                    local forwardAmount = hum.MoveDirection:Dot(fUnit)
                    local rightAmount = hum.MoveDirection:Dot(rUnit)
                    moveDir = (lookVec * forwardAmount) + (rightVec * rightAmount)
                else
                    moveDir = hum.MoveDirection
                end
            end

            if moveDir.Magnitude > 0.001 then
                local unitVel = moveDir.Unit * flySpeed
                FlyBodyVelocity.Velocity = unitVel
                hrp.AssemblyLinearVelocity = unitVel
                hrp.CFrame = CFrame.new(hrp.Position + (unitVel * stepDt)) * (camCf - camCf.Position)
            else
                FlyBodyVelocity.Velocity = Vector3.zero
                hrp.AssemblyLinearVelocity = Vector3.zero
                hrp.AssemblyAngularVelocity = Vector3.zero
                hrp.CFrame = CFrame.new(hrp.Position) * (camCf - camCf.Position)
            end
            FlyBodyGyro.CFrame = camCf
        else
            if FlyBodyVelocity then
                pcall(function() FlyBodyVelocity:Destroy() end)
                FlyBodyVelocity = nil
            end
            if FlyBodyGyro then
                pcall(function() FlyBodyGyro:Destroy() end)
                FlyBodyGyro = nil
            end
            if FlyPlatformStandActive then
                FlyPlatformStandActive = false
                if hum then
                    hum.PlatformStand = false
                    pcall(function()
                        hum:ChangeState(Enum.HumanoidStateType.GettingUp)
                    end)
                end
                if hrp then
                    hrp.AssemblyLinearVelocity = Vector3.zero
                    hrp.AssemblyAngularVelocity = Vector3.zero
                end
            end
        end
    end
    Ony.UpdateFlightController = UpdateFlightController

    -- // 7.6 Seamless Safezone + Controllable Clone Invisibility Engine
    -- Moves the real character safely to the Elevated Safezone Sky Platform while giving
    -- the player 100% responsive control of a local clone at their current location.
    -- When disabled, seamlessly transfers the real character to the clone's exact CFrame,
    -- velocity, camera angle, and movement vector in a single frame with zero teleport snap!
    local InvisRealCharacter = nil
    local InvisCloneCharacter = nil
    local InvisCloneActive = false

    local function DisableInvisibilityCloneSeamless(forceFallback)
        if not InvisCloneActive then
            return
        end
        InvisCloneActive = false

        local realChar = InvisRealCharacter
        local cloneChar = InvisCloneCharacter
        InvisRealCharacter = nil
        InvisCloneCharacter = nil

        local realHrp = realChar and realChar:FindFirstChild("HumanoidRootPart")
        local realHum = realChar and realChar:FindFirstChildOfClass("Humanoid")
        local cloneHrp = cloneChar and cloneChar:FindFirstChild("HumanoidRootPart")
        local cloneHum = cloneChar and cloneChar:FindFirstChildOfClass("Humanoid")

        local savedCamCf = Camera and Camera.CFrame
        local targetCf = cloneHrp and cloneHrp.CFrame or (realHrp and realHrp.CFrame)
        local targetVel = cloneHrp and cloneHrp.AssemblyLinearVelocity or Vector3.zero
        local targetRotVel = cloneHrp and cloneHrp.AssemblyAngularVelocity or Vector3.zero
        local targetMoveDir = cloneHum and cloneHum.MoveDirection or Vector3.zero
        local targetState = cloneHum and cloneHum:GetState() or Enum.HumanoidStateType.Running

        if realChar and realChar.Parent and realHrp and realHum then
            pcall(function()
                -- Transfer any equipped tool from clone back to real character
                if cloneChar then
                    for _, child in ipairs(cloneChar:GetChildren()) do
                        if child:IsA("Tool") then
                            child.Parent = realChar
                        end
                    end
                end

                realHrp.Anchored = false
                for _, desc in ipairs(realChar:GetDescendants()) do
                    if desc:IsA("BasePart") or desc:IsA("Decal") then
                        desc.LocalTransparencyModifier = 0
                    end
                end

                if targetCf and not forceFallback then
                    realHrp.CFrame = targetCf
                    realHrp.AssemblyLinearVelocity = targetVel
                    realHrp.AssemblyAngularVelocity = targetRotVel
                end

                LocalPlayer.Character = realChar
                if Camera then
                    Camera.CameraSubject = realHum
                    if savedCamCf then
                        Camera.CFrame = savedCamCf
                    end
                end

                if targetState == Enum.HumanoidStateType.Jumping or targetState == Enum.HumanoidStateType.Freefall then
                    realHum:ChangeState(targetState)
                else
                    realHum:ChangeState(Enum.HumanoidStateType.Running)
                end
                if targetMoveDir.Magnitude > 0 then
                    realHum:Move(targetMoveDir, false)
                end
            end)
        end

        if cloneChar then
            pcall(function()
                cloneChar:Destroy()
            end)
        end
    end
    Ony.DisableInvisibilityCloneSeamless = DisableInvisibilityCloneSeamless

    local function EnableInvisibilityCloneSeamless()
        if InvisCloneActive then
            return
        end
        local realChar = LocalPlayer.Character
        local realHrp = realChar and realChar:FindFirstChild("HumanoidRootPart")
        local realHum = realChar and realChar:FindFirstChildOfClass("Humanoid")
        if not realChar or not realHrp or not realHum or realHum.Health <= 0 then
            return
        end

        local startCf = realHrp.CFrame
        local startVel = realHrp.AssemblyLinearVelocity
        local startMoveDir = realHum.MoveDirection
        local savedCamCf = Camera and Camera.CFrame

        local ok, cloneChar = pcall(function()
            realChar.Archivable = true
            local c = realChar:Clone()
            c.Name = "OnyInvisControllerClone"
            return c
        end)

        local cloneHrp = ok and cloneChar and cloneChar:FindFirstChild("HumanoidRootPart")
        local cloneHum = ok and cloneChar and cloneChar:FindFirstChildOfClass("Humanoid")
        if not cloneHrp or not cloneHum then
            if cloneChar then pcall(function() cloneChar:Destroy() end) end
            return
        end

        InvisRealCharacter = realChar
        InvisCloneCharacter = cloneChar
        InvisCloneActive = true

        pcall(function()
            -- 1. Place Controllable Clone at Exact Current Position & Velocity
            cloneChar.Parent = Workspace
            cloneHrp.Anchored = false
            cloneHrp.CFrame = startCf
            cloneHrp.AssemblyLinearVelocity = startVel
            Ony.TrackWorldInstance(cloneChar)

            -- Style Clone with Subtle Ghost Shimmer on Local Screen
            for _, desc in ipairs(cloneChar:GetDescendants()) do
                if (desc:IsA("BasePart") or desc:IsA("Decal")) and desc.Name ~= "HumanoidRootPart" then
                    desc.LocalTransparencyModifier = 0.32
                end
            end

            -- 2. Send Real Character to Elevated Safezone Sky Platform & Anchor Safely
            local plat = GetOrCreateSafezonePlatform()
            local map = FindActiveMap()
            local basePos = startCf.Position
            if map and map:FindFirstChild("Spawns") then
                local sp = map.Spawns:FindFirstChildWhichIsA("BasePart")
                if sp then basePos = sp.Position end
            end
            plat.Position = Vector3.new(basePos.X, basePos.Y + 145, basePos.Z)
            realHrp.AssemblyLinearVelocity = Vector3.zero
            realHrp.AssemblyAngularVelocity = Vector3.zero
            realHrp.CFrame = CFrame.new(plat.Position + Vector3.new(0, 4.5, 0))
            realHrp.Anchored = true

            -- 3. Seamlessly Switch LocalPlayer Control & Camera to Clone Without Frame Jerk
            LocalPlayer.Character = cloneChar
            if Camera then
                Camera.CameraSubject = cloneHum
                if savedCamCf then
                    Camera.CFrame = savedCamCf
                end
            end
            if startMoveDir.Magnitude > 0 then
                cloneHum:Move(startMoveDir, false)
            end
        end)

        NotifyToast("Clone Invisibility", "Real character anchored on Safezone! Controlling ghost clone.")
    end

    local function UpdateInvisibilityState()
        if Flags["invisibility"] then
            if not InvisCloneActive then
                EnableInvisibilityCloneSeamless()
            else
                -- Verify both real character and clone character remain valid
                local realValid = InvisRealCharacter
                    and InvisRealCharacter.Parent
                    and InvisRealCharacter:FindFirstChild("HumanoidRootPart")
                    and InvisRealCharacter:FindFirstChildOfClass("Humanoid")
                    and InvisRealCharacter:FindFirstChildOfClass("Humanoid").Health > 0
                local cloneValid = InvisCloneCharacter
                    and InvisCloneCharacter.Parent
                    and InvisCloneCharacter:FindFirstChild("HumanoidRootPart")
                    and InvisCloneCharacter:FindFirstChildOfClass("Humanoid")
                    and InvisCloneCharacter:FindFirstChildOfClass("Humanoid").Health > 0

                if not realValid or not cloneValid then
                    DisableInvisibilityCloneSeamless(true)
                    Ony.SetFlagState("invisibility", false, true)
                else
                    -- Keep Real Character Safely Anchored on Sky Platform
                    local realHrp = InvisRealCharacter:FindFirstChild("HumanoidRootPart")
                    if realHrp and SafezonePlatformPart then
                        realHrp.AssemblyLinearVelocity = Vector3.zero
                        realHrp.CFrame = CFrame.new(SafezonePlatformPart.Position + Vector3.new(0, 4.5, 0))
                        realHrp.Anchored = true
                    end
                    -- Ensure LocalTransparencyModifier stays visible as a sleek ghost on Clone
                    for _, desc in ipairs(InvisCloneCharacter:GetDescendants()) do
                        if (desc:IsA("BasePart") or desc:IsA("Decal")) and desc.Name ~= "HumanoidRootPart" then
                            desc.LocalTransparencyModifier = 0.32
                        end
                    end
                end
            end
        elseif InvisCloneActive then
            DisableInvisibilityCloneSeamless(false)
            NotifyToast("Clone Invisibility", "Synced back to clone position seamlessly!")
        end
    end
    Ony.UpdateInvisibilityState = UpdateInvisibilityState

