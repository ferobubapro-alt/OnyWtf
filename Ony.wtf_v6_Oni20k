local function CreateSafeDrawing(drawingType, props)
    if not ExecutorCaps.HasDrawing then
        return nil
    end
    local ok, obj = pcall(function()
        return Drawing.new(drawingType)
    end)
    if not ok or not obj then
        return nil
    end
    if type(props) == "table" then
        for k, v in pairs(props) do
            pcall(function()
                obj[k] = v
            end)
        end
    end
    table.insert(Ony.ActiveDrawingObjects, obj)
    return obj
end
Ony.CreateSafeDrawing = CreateSafeDrawing

