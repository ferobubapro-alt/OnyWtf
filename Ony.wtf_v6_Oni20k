    local function QueueAutoReExecute()
        if TeleportQueueRegistered then
            return
        end
        TeleportQueueRegistered = true

        -- Save active session state so it reloads automatically in the new server
        pcall(function()
            SaveConfigurationToDisk(false, AUTOLOAD_TELEPORT_FILE)
        end)

        pcall(function()
            local queueFn = (type(queue_on_teleport) == "function" and queue_on_teleport)
                or (type(queueonteleport) == "function" and queueonteleport)
                or (type(syn) == "table" and type(syn.queue_on_teleport) == "function" and syn.queue_on_teleport)
                or (type(fluxus) == "table" and type(fluxus.queue_on_teleport) == "function" and fluxus.queue_on_teleport)

            if queueFn then
                local payload = [[
                    repeat task.wait(0.1) until game:IsLoaded()
                    local g = (type(getgenv) == "function" and getgenv()) or _G
                    g.OnyWtfTeleportAutoLoad = true
                    if type(isfile) == "function" and isfile("OnyWtf/Ony.wtf_MM2.luau") then
                        loadstring(readfile("OnyWtf/Ony.wtf_MM2.luau"))()
                    elseif g.OnyWtfScriptSource and type(g.OnyWtfScriptSource) == "string" then
                        loadstring(g.OnyWtfScriptSource)()
                    elseif g.OnyWtfScriptUrl and type(g.OnyWtfScriptUrl) == "string" then
                        loadstring(game:HttpGet(g.OnyWtfScriptUrl))()
                    end
                ]]
                queueFn(payload)
            end
        end)
    end
