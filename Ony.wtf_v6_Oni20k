    local function SaveConfigurationToDisk(notify, customPath)
        local targetPath = customPath or CONFIG_FILE
        Ony.GlobalEnv.OnyWtfSavedSessionConfig = {
            Flags = {},
            Values = {},
        }
        for k, v in pairs(Flags) do
            Ony.GlobalEnv.OnyWtfSavedSessionConfig.Flags[k] = v
        end
        for k, v in pairs(Values) do
            Ony.GlobalEnv.OnyWtfSavedSessionConfig.Values[k] = v
        end

        if not ExecutorCaps.HasFileSystem then
            if notify then
                NotifyToast("Config Manager", "Saved custom profile to session memory!")
            end
            return
        end
        pcall(function()
            if not isfolder(CONFIG_FOLDER) then
                makefolder(CONFIG_FOLDER)
            end
            local exportData = {
                Flags = Flags,
                Values = Values,
            }
            writefile(targetPath, HttpService:JSONEncode(exportData))
        end)
        if notify then
            NotifyToast("Config Manager", "Saved configuration to workspace/" .. targetPath .. "!")
        end
    end
    Ony.SaveConfigurationToDisk = SaveConfigurationToDisk

    local function LoadConfigurationFromDisk(notify, customPath)
        local targetPath = customPath or CONFIG_FILE
        if not ExecutorCaps.HasFileSystem then
            local mem = Ony.GlobalEnv.OnyWtfSavedSessionConfig
            if type(mem) == "table" then
                if type(mem.Flags) == "table" then
                    for k, v in pairs(mem.Flags) do
                        Ony.SetFlagState(k, v == true, true)
                    end
                end
                if type(mem.Values) == "table" then
                    for k, v in pairs(mem.Values) do
                        Values[k] = v
                        if Ony.SubValueVisualSyncCallbacks[k] then
                            pcall(Ony.SubValueVisualSyncCallbacks[k], v)
                        end
                    end
                end
                if Ony.UpdateKeybindFlagsHUD then Ony.UpdateKeybindFlagsHUD() end
                if notify then
                    NotifyToast("Config Manager", "Loaded custom profile from session memory!")
                end
            end
            return
        end
        pcall(function()
            if isfile(targetPath) then
                local raw = readfile(targetPath)
                local decoded = HttpService:JSONDecode(raw)
                if type(decoded) == "table" then
                    if type(decoded.Flags) == "table" then
                        for k, v in pairs(decoded.Flags) do
                            Ony.SetFlagState(k, v == true, true)
                        end
                    end
                    if type(decoded.Values) == "table" then
                        for k, v in pairs(decoded.Values) do
                            Values[k] = v
                            if Ony.SubValueVisualSyncCallbacks[k] then
                                pcall(Ony.SubValueVisualSyncCallbacks[k], v)
                            end
                        end
                    end
                    if Ony.UpdateKeybindFlagsHUD then Ony.UpdateKeybindFlagsHUD() end
                    if notify then
                        NotifyToast("Config Manager", "Loaded saved profile from " .. targetPath .. "!")
                    end
                end
            elseif notify then
