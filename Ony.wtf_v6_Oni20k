    -- ============================================================================
    local PerfOptimizer = {
        SpatialCoins = {},
        SpatialCandies = {},
        SpatialFruits = {},
        SpatialBalls = {},
        DrawingPool = { Lines = {}, Squares = {}, Circles = {}, Triangles = {}, Texts = {} },
        HighlightPool = {},
        LastWorkspaceScan = 0,
        ScanInterval = 0.65,
        FrameBudgetMs = 2.5,
        CullDistanceSq = 3000 * 3000,
    }
    Ony.PerfOptimizer = PerfOptimizer

    function PerfOptimizer:AcquireDrawing(drawType)
        if not Ony.ExecutorCaps or not Ony.ExecutorCaps.HasDrawing then
            return nil
        end
        local pool = self.DrawingPool[drawType]
        if pool and #pool > 0 then
            local item = table.remove(pool)
            pcall(function() item.Visible = true end)
            return item
        end
        local ok, obj = pcall(function() return Drawing.new(drawType) end)
        if ok and obj then
            return obj
        end
        return nil
    end

    function PerfOptimizer:ReleaseDrawing(drawType, obj)
        if not obj then return end
        pcall(function() obj.Visible = false end)
        local pool = self.DrawingPool[drawType]
        if pool and #pool < 256 then
            table.insert(pool, obj)
        else
            pcall(function() obj:Remove() end)
        end
    end

    function PerfOptimizer:IsWithinCullDistance(posA, posB, maxDist)
        if not posA or not posB then return false end
        local dx = posA.X - posB.X
        local dy = posA.Y - posB.Y
        local dz = posA.Z - posB.Z
        local dSq = dx * dx + dy * dy + dz * dz
        local limit = maxDist and (maxDist * maxDist) or self.CullDistanceSq
        return dSq <= limit, dSq
    end

    function PerfOptimizer:RefreshSpatialCacheNow()
        local now = os.clock()
        if (now - self.LastWorkspaceScan) < self.ScanInterval then
            return
        end
        self.LastWorkspaceScan = now
        table.clear(self.SpatialCoins)
        table.clear(self.SpatialCandies)
