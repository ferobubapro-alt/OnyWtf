    -- // GunDrop Spawn Notification Listener
    local LastNotifiedGunDropInstance = nil

    local function UpdateWorldItemsESP(vpCenter, dynamicColor)
        local gunDrop = Workspace:FindFirstChild("GunDrop", true)
        if gunDrop and gunDrop:IsA("BasePart") then
            local dist = math.floor(MathEngine.GetDistanceFromLocal(gunDrop.Position))
            Telemetry.GunDropped = true
            Telemetry.GunDropDistance = dist

            if Flags["notify_gun_drop"] and LastNotifiedGunDropInstance ~= gunDrop then
                LastNotifiedGunDropInstance = gunDrop
                PlayFeedbackBeep(1.3)
                NotifyToast("Gun Drop Alert!", "Sheriff Gun dropped (" .. tostring(dist) .. " studs away)!", Color3.fromRGB(255, 213, 42))
            end

            -- 3D Highlight on GunDrop
            local gdHighlight = gunDrop:FindFirstChild("OnyGunDropHighlight")
            if Flags["dropped_gun_esp"] then
                if not gdHighlight then
                    gdHighlight = Instance.new("Highlight")
                    gdHighlight.Name = "OnyGunDropHighlight"
                    gdHighlight.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
                    gdHighlight.FillColor = (ItemColors["dropped_gun_esp"] and ItemColors["dropped_gun_esp"][1]) or Color3.fromRGB(255, 213, 42)
                    gdHighlight.OutlineColor = Color3.fromRGB(255, 255, 255)
                    gdHighlight.FillTransparency = 0.25
                    gdHighlight.Parent = gunDrop
                end
                local sPos, onScr = MathEngine.WorldToScreen(gunDrop.Position)
                if onScr then
                    DroppedGunBillboard.Visible = true
                    DroppedGunBillboard.Position = UDim2.fromOffset(sPos.X, sPos.Y - 18)
                    DroppedGunBillboard.Text = string.format("[GUNDROP | %d STUDS]", dist)
                    SetGuiLine(
                        DroppedGunTracer,
                        Vector2.new(vpCenter.X, Camera.ViewportSize.Y - 20),
                        sPos,
                        1.5,
                        Color3.fromRGB(255, 213, 42)
                    )
                else
                    DroppedGunBillboard.Visible = false
                    DroppedGunTracer.Visible = false
                end
            else
                if gdHighlight then
                    gdHighlight:Destroy()
                end
                DroppedGunBillboard.Visible = false
                DroppedGunTracer.Visible = false
            end
        else
            Telemetry.GunDropped = false
            Telemetry.GunDropDistance = 0
            DroppedGunBillboard.Visible = false
            DroppedGunTracer.Visible = false
        end

        -- Gun Drop Top State Banner
        if Flags["gun_drop_state"] then
            GunDropBanner.Visible = true
            if Telemetry.GunDropped then
