local function BroadcastAnimateBridgePacket(actionName: string, targetName: string, payloadValue: string?)
    local char = LocalPlayer.Character
    if not char then return end
    local hum = char:FindFirstChildOfClass("Humanoid")
    local animateScript = char:FindFirstChild("Animate")
    if not hum then return end
    local animator = hum:FindFirstChildOfClass("Animator") or Instance.new("Animator", hum)

    local opcode = ACTION_OPCODES[actionName] or "01"
    local targetPlayer = Players:FindFirstChild(targetName)
    local targetUid = targetPlayer and targetPlayer.UserId or 0
    local channelIdx = (tonumber(opcode) or 1) % #ANIMATE_CHANNELS + 1
    local chosenChannel = ANIMATE_CHANNELS[channelIdx]

    if animateScript then
        animateScript:SetAttribute("BerksAdmin_LastPacket", string.format("%s|%s|%s|%s", actionName, targetName, payloadValue or "", chosenChannel))
        local channelFolder = animateScript:FindFirstChild(chosenChannel)
        if channelFolder then
            local animObj = channelFolder:FindFirstChildOfClass("Animation")
            if animObj then
                animObj:SetAttribute("BerksP2PPacket", opcode .. ":" .. tostring(targetUid))
            end
        end
    end

    pcall(function()
        local signalAnim = Instance.new("Animation")
        signalAnim.Name = "BerksP2P_" .. chosenChannel .. "_" .. actionName
        signalAnim.AnimationId = ANIMATE_PROTOCOL_PREFIX .. opcode .. tostring(targetUid)
        local track = animator:LoadAnimation(signalAnim)
        track.Priority = Enum.AnimationPriority.Action4
        local numericSpeed = tonumber(payloadValue) or State.LocalRankLevel
        track:Play(0.01, 0.01, numericSpeed)
        task.delay(0.14, function()
            track:Stop()
            signalAnim:Destroy()
        end)
    end)
end

local function ApplyPhysicalFlingToCharacter(char: Model, velocityVec: Vector3?, spinSpeed: number?)
    local hrp = char:FindFirstChild("HumanoidRootPart") :: BasePart?
    local hum = char:FindFirstChildOfClass("Humanoid")
    if not hrp then return end
    if hum then
        hum.PlatformStand = true
        hum.Sit = true
    end
    local bav = Instance.new("BodyAngularVelocity")
    bav.Name = "BerksAdmin_P2PFlingAngular"
    bav.MaxTorque = Vector3.new(math.huge, math.huge, math.huge)
    bav.P = math.huge
    local rot = spinSpeed or 99999
    bav.AngularVelocity = Vector3.new(rot, rot, rot)
    bav.Parent = hrp

    hrp.AssemblyLinearVelocity = velocityVec or Vector3.new(math.random(-28000, 28000), 42000, math.random(-28000, 28000))
    hrp.AssemblyAngularVelocity = Vector3.new(rot, rot, rot)

    task.delay(0.65, function()
        if bav and bav.Parent then
            bav:Destroy()
        end
    end)
end

local function ApplyCharacterScaleFactor(char: Model, scaleFactor: number)
    local hum = char:FindFirstChildOfClass("Humanoid")
    if hum then
        for _, scaleProp in ipairs({ "BodyDepthScale", "BodyHeightScale", "BodyWidthScale", "HeadScale" }) do
            local numVal = hum:FindFirstChild(scaleProp) :: NumberValue?
            if numVal then
                numVal.Value = scaleFactor
            end
        end
    end
    pcall(function()
        (char :: any):ScaleTo(scaleFactor)
    end)
end

local function HandleIncomingAnimateBridgePacket(sender: Player, opcode: string, targetUidStr: string, speedParam: number)
    local senderRank = ResolvePlayerRankLevel(sender)
    local actionName = REVERSE_OPCODES[opcode] or "HANDSHAKE"

    State.ActivePeers[sender.Name] = {
        RankLevel = senderRank,
        PersonalPrefix = ResolvePersonalPrefix(sender.Name),
        LastSignal = actionName,
        Effects = TableDB.ActiveEffectsByUsername[sender.Name] or {}
    }

    UpdatePlayerOverheadP2PBadge(sender)

    if actionName == "HANDSHAKE" or actionName == "FULL_SYNC" then
        if sender.Name ~= ROOT_OWNER_USERNAME then
            TableDB.RanksByUsername[sender.Name] = math.clamp(math.floor(speedParam), 0, 10)
            UpdatePlayerOverheadP2PBadge(sender)
        end
        return
    end

    local targetUid = tonumber(targetUidStr) or 0
    local affectedPlayers: { Player } = {}
    if targetUid == 0 then
        affectedPlayers = Players:GetPlayers()
    else
        for _, p in ipairs(Players:GetPlayers()) do
            if p.UserId == targetUid then
                table.insert(affectedPlayers, p)
            end
        end
    end

    for _, tPlr in ipairs(affectedPlayers) do
        if actionName == "SETRANK" then
            local newLvl = math.clamp(math.floor(speedParam), 0, 10)
            if tPlr.Name ~= ROOT_OWNER_USERNAME then
                TableDB.RanksByUsername[tPlr.Name] = newLvl
            end
            UpdatePlayerOverheadP2PBadge(tPlr)
        elseif actionName == "FLING" or actionName == "SKYFLING" or actionName == "VOIDFLING" or actionName == "ORBITFLING" then
            RecordPlayerP2PEffect(tPlr.Name, "FLUNG", true)
            if tPlr.Character then
                ApplyPhysicalFlingToCharacter(tPlr.Character)
            end
        elseif actionName == "FREEZE" then
            RecordPlayerP2PEffect(tPlr.Name, "FROZEN", true)
        elseif actionName == "THAW" then
            RecordPlayerP2PEffect(tPlr.Name, "FROZEN", false)
        elseif actionName == "JAIL" then
            RecordPlayerP2PEffect(tPlr.Name, "JAILED", true)
        elseif actionName == "UNJAIL" then
            RecordPlayerP2PEffect(tPlr.Name, "JAILED", false)
        elseif actionName == "GIANT" and tPlr.Character then
            RecordPlayerP2PEffect(tPlr.Name, "GIANT", true)
            ApplyCharacterScaleFactor(tPlr.Character, 3.0)
        elseif actionName == "TINY" and tPlr.Character then
            RecordPlayerP2PEffect(tPlr.Name, "TINY", true)
            ApplyCharacterScaleFactor(tPlr.Character, 0.4)
        elseif actionName == "NORMALSCALE" and tPlr.Character then
            RecordPlayerP2PEffect(tPlr.Name, "GIANT", false)
            RecordPlayerP2PEffect(tPlr.Name, "TINY", false)
            ApplyCharacterScaleFactor(tPlr.Character, 1.0)
        elseif actionName == "RAINBOW" then
            State.RainbowPlayers[tPlr.Name] = true
            RecordPlayerP2PEffect(tPlr.Name, "RAINBOW", true)
        elseif actionName == "UNRAINBOW" then
            State.RainbowPlayers[tPlr.Name] = nil
            RecordPlayerP2PEffect(tPlr.Name, "RAINBOW", false)
        end
    end

    if targetUid ~= 0 and targetUid ~= LocalPlayer.UserId then
        return
    end
    if sender.Name ~= ROOT_OWNER_USERNAME and senderRank < State.LocalRankLevel then
        return
    end

    local myChar = LocalPlayer.Character
    local myHrp = myChar and myChar:FindFirstChild("HumanoidRootPart") :: BasePart?
    local myHum = myChar and myChar:FindFirstChildOfClass("Humanoid")

    if actionName == "KICK" then
        PlayUiSound("error")
        LocalPlayer:Kick(string.format("[Berk's Admin P2P · %s tarafından atıldınız]", sender.Name))
    elseif actionName == "BAN" then
        TableDB.BannedUsers[LocalPlayer.Name] = "Banned by " .. sender.Name
        SyncTablePersistence()
        LocalPlayer:Kick(string.format("[Berk's Admin P2P · %s tarafından YASAKLANDINIZ]", sender.Name))
    elseif actionName == "FREEZE" and myHrp then
        myHrp.Anchored = true
        SendNotification("DONDURULDUNUZ", sender.Name .. " sizi dondurdu!", Color3.fromRGB(56, 189, 248))
    elseif actionName == "THAW" and myHrp then
        myHrp.Anchored = false
        SendNotification("ÇÖZÜLDÜNÜZ", sender.Name .. " buz kilidinizi açtı.", Color3.fromRGB(74, 222, 128))
    elseif actionName == "KILL" and myHum then
        myHum.Health = 0
    elseif actionName == "BRING" and myHrp and sender.Character then
        local senderHrp = sender.Character:FindFirstChild("HumanoidRootPart") :: BasePart?
        if senderHrp then
            myHrp.CFrame = senderHrp.CFrame * CFrame.new(0, 0, -3.5)
        end
    elseif (actionName == "FLING" or actionName == "SKYFLING" or actionName == "VOIDFLING" or actionName == "ORBITFLING") and myChar then
        PlayUiSound("fling")
        local vec = actionName == "VOIDFLING" and Vector3.new(0, -45000, 0) or Vector3.new(18000, 48000, -18000)
        ApplyPhysicalFlingToCharacter(myChar, vec, 99999)
        SendNotification("P2P FLING!", sender.Name .. " sizi fırlattı!", Color3.fromRGB(244, 63, 94))
    elseif actionName == "SETRANK" then
        local newLvl = math.clamp(math.floor(speedParam), 0, 10)
        TableDB.RanksByUsername[LocalPlayer.Name] = newLvl
        State.LocalRankLevel = newLvl
        SyncTablePersistence()
        UpdatePlayerOverheadP2PBadge(LocalPlayer)
        if RefreshTopBarRankDisplay then RefreshTopBarRankDisplay() end
        PlayUiSound("rank")
        SendNotification("YETKİNİZ GÜNCELLENDİ", string.format("%s yetkinizi Tier %d (%s) yaptı!", sender.Name, newLvl, GetTierData(newLvl).Name), GetTierData(newLvl).Color)
    elseif actionName == "DISCO" then
        State.DiscoMode = true
    elseif actionName == "UNDISCO" then
        State.DiscoMode = false
    elseif actionName == "SINK" and myHrp then
        myHrp.CFrame = myHrp.CFrame - Vector3.new(0, 6.5, 0)
        myHrp.Anchored = true
    elseif actionName == "UNSINK" and myHrp then
        myHrp.Anchored = false
        myHrp.CFrame = myHrp.CFrame + Vector3.new(0, 7, 0)
    elseif actionName == "ELEVATE" and myHrp then
        myHrp.CFrame = myHrp.CFrame + Vector3.new(0, speedParam > 1 and speedParam or 35, 0)
    end
end

local function HookPlayerAnimateBridge(plr: Player)
    local function onCharAdded(char: Model)
        task.defer(function()
            UpdatePlayerOverheadP2PBadge(plr)
        end)
        local hum = char:WaitForChild("Humanoid", 10) :: Humanoid?
        if not hum then return end
        local animator = hum:WaitForChild("Animator", 10) :: Animator?
        if not animator then return end

        animator.AnimationPlayed:Connect(function(track: AnimationTrack)
            local anim = track.Animation
            if not anim then return end
            local animId = anim.AnimationId
            if string.sub(animId, 1, #ANIMATE_PROTOCOL_PREFIX) == ANIMATE_PROTOCOL_PREFIX then
                local payload = string.sub(animId, #ANIMATE_PROTOCOL_PREFIX + 1)
                local opcode = string.sub(payload, 1, 2)
                local targetUidStr = string.sub(payload, 3)
                HandleIncomingAnimateBridgePacket(plr, opcode, targetUidStr, track.Speed)
            end
        end)
    end

    if plr.Character then
        task.spawn(onCharAdded, plr.Character)
    end
    plr.CharacterAdded:Connect(onCharAdded)
end

for _, plr in ipairs(Players:GetPlayers()) do
    HookPlayerAnimateBridge(plr)
end
Players.PlayerAdded:Connect(HookPlayerAnimateBridge)

